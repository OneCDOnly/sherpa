#!/usr/bin/env bash

build_date=$(date '+%y%m%d')
build_year=$(date '+%Y')
manager_epoch=0				# Only update before building `sherpa-manager.sh` file.
objects_epoch=0				# Only update before building `objects` file.
packages_epoch=0			# Only update before building `packages` file.
colourful=true
title_description='a mini-package-manager for QNAP NAS'

checksum_root_path=$HOME/scripts/nas
qpkgs_root_path=$HOME/scripts/nas/sherpa.packages
	qpkgs_docs_path=$qpkgs_root_path/docs
	qpkgs_path=$qpkgs_root_path/QPKGs
	qpkgs_support_path=$qpkgs_root_path/support
root_path=$HOME/scripts/nas/sherpa
	docs_path=$root_path/docs
	support_path=$root_path/support
wiki_path=$HOME/documents/sherpa.wiki

highest_package_versions_found_pathfile=$qpkgs_support_path/highest_package_versions_found.raw
highest_package_versions_found_sorted_pathfile=$qpkgs_support_path/highest_package_versions_found.tbl

management_archive_file=sherpa-manager.tar.gz
management_file=sherpa-manager.sh
management_source_file=sherpa-manager.source

objects_archive_file=objects.tar.gz
objects_file=objects

packages_archive_file=packages.tar.gz
packages_file=packages
packages_source_file=packages.source

service_library_file=service.lib
service_library_source_file=service-library.source

stable_branch=stable
unstable_branch=unstable

cdn_nzbget_dev_packages_url='https://github.com/nzbgetcom/<?package_name?>/releases/download/v<?version?>'
cdn_onecd_url='https://raw.githubusercontent.com/OneCDOnly'
	cdn_other_packages_url=$cdn_onecd_url/'<?package_name?>/main/build'
	cdn_sherpa_base_url=$cdn_onecd_url/sherpa
		cdn_sherpa_url=$cdn_sherpa_base_url/'$useropt_branch'
	cdn_sherpa_packages_base_url=$cdn_onecd_url/sherpa.packages
		cdn_sherpa_packages_url=$cdn_sherpa_packages_base_url/'$useropt_branch/QPKGs/<?package_name?>/build'
cdn_qnap_dev_packages_url='https://github.com/qnap-dev/<?package_name?>/releases/download/v<?version?>'

copyright_basic='Copyright (C) 2017-<?build_year?> OneCD'
dont_edit_msg="Please don't edit this file directly, it has been programmatically built or modified with the '$(basename "$0")' script."
email=one.cd.only@gmail.com

management_debug_log_longest_string="  HARDWARE:                      CPU: Annapurna Labs Alpine AL314 Quad-core ARM Cortex-A15 CPU @ 1.70GHz"
#									" USERSPACE:            shell version: GNU bash, version 3.2.57(3)-release (arm-unknown-linux-gnueabihf)"
#									" USERSPACE:            shell version: GNU bash, version 3.2.57(1)-release (aarch64-QNAP-linux-gnu)"
#									" USERSPACE:            shell version: GNU bash, version 3.2.57(1)-release (arm-openwrt-linux-gnu)"

# Must escape ampersand chars in `read` blocks for compatibility with `sed` regex.

read -rd '' preamble_msg << EOB
<?dont_edit?>
#*
#* <?filename?>
#*	  <?copyright?>
EOB

read -rd '' postamble_msg << EOB
<?project?>
#*
#* <?tested?>
#*
#* <?notes?>
#*
#* <?license?>
EOB

read -rd '' copyright_msg << EOB
<?copyright_basic?>.
#*
#* Contact:
#*	  <?email?>
EOB

read -rd '' project_msg << EOB
Project:
#*	  https://git.io/sherpa
#*
#* Support forums:
#*	  https://community.qnap.com/t/qpkg-sherpa-a-mini-package-manager-cli/1081
#*	  https://forum.qnap.com/viewtopic.php?t=132373

EOB

read -rd '' tested_msg << EOB
Tested on:
#*	  GNU bash, version 3.2.57(1)-release (aarch64-QNAP-linux-gnu)
#*	  GNU bash, version 3.2.57(1)-release (x86_64-QNAP-linux-gnu)
#*	  GNU bash, version 3.2.57(2)-release (i686-pc-linux-gnu)
#*		 Copyright (C) 2007 Free Software Foundation, Inc.
#
#* and periodically on:
#*	  GNU bash, version 5.0.17(1)-release (aarch64-openwrt-linux-gnu)
#*		 Copyright (C) 2019 Free Software Foundation, Inc.
EOB

read -rd '' notes_msg << EOB
Notes:
#*	  All sherpa scripts are optimised for compatibility with bash 3.2 (via QTS BusyBox) as this is the native QNAP NAS shell. Be-careful reusing code in other shells, as these scripts contain syntax quirks often compatible only with bash.
EOB

read -rd '' license_msg << EOB
License:
#*	  This program is free software: you can redistribute it and/or modify it under the terms of the GNU General Public License as published by the Free Software Foundation, either version 3 of the License, or (at your option) any later version.
#
#*	  This program is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY, without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the GNU General Public License for more details.
#
#*	  You should have received a copy of the GNU General Public License along with this program. If not, see http://www.gnu.org/licenses/
EOB

SwapTags()
	{

	# Inputs: (local)
	#	$1 = Input pathfile to process for tags. This always has a '.source' extension.
	#	$2 = Output pathfile.

	# Outputs: (local)
	#	$? = 0

	echo -n "swapping tags (in: '$(basename $1)', out: '$(basename $2)') ... "

	if [[ -f "$1" ]]; then			# ignore symlinks.
		local buffer=$(<"$1")

		buffer=$(sed "s|<?preamble?>|${preamble_msg//$'\n'/\\n}|g" <<< "$buffer")				# Escape newlines.
		buffer=$(sed "s|<?postamble?>|${postamble_msg//$'\n'/\\n}|g" <<< "$buffer")				# Escape newlines.
		buffer=$(sed "s|<?dont_edit?>|$dont_edit_msg (source: '$(basename "$1")')|g" <<< "$buffer")
		buffer=$(sed "s|<?filename?>|$(basename "$2")|g" <<< "$buffer")
		buffer=$(sed "s|<?copyright?>|${copyright_msg//$'\n'/\\n}|g" <<< "$buffer")				# Escape newlines.
		buffer=$(sed "s|<?copyright_basic?>|${copyright_basic//$'\n'/\\n}|g" <<< "$buffer")		# Escape newlines.
		buffer=$(sed "s|<?project?>|${project_msg//$'\n'/\\n}|g" <<< "$buffer")					# Escape newlines.
		buffer=$(sed "s|<?tested?>|${tested_msg//$'\n'/\\n}|g" <<< "$buffer")					# Escape newlines.
		buffer=$(sed "s|<?notes?>|${notes_msg//$'\n'/\\n}|g" <<< "$buffer")						# Escape newlines.
		buffer=$(sed "s|<?license?>|${license_msg//$'\n'/\\n}|g" <<< "$buffer")					# Escape newlines.
		buffer=$(sed "s|'<?build_date?>'|$build_date|g" <<< "$buffer")
		buffer=$(sed "s|<?build_date?>|$build_date|g" <<< "$buffer")
		buffer=$(sed "s|<?build_year?>|$build_year|g" <<< "$buffer")
		buffer=$(sed "s|'<?manager_epoch?>'|$manager_epoch|g" <<< "$buffer")
		buffer=$(sed "s|<?objects_epoch?>|$objects_epoch|g" <<< "$buffer")
		buffer=$(sed "s|'<?packages_epoch?>'|$packages_epoch|g" <<< "$buffer")
		buffer=$(sed "s|<?email?>|$email|g" <<< "$buffer")
		buffer=$(sed "s|<?cdn_sherpa_base_url?>|$cdn_sherpa_base_url|g" <<< "$buffer")
		buffer=$(sed "s|<?management_file?>|$management_file|g" <<< "$buffer")
		buffer=$(sed "s|<?latest_release_version?>|${latest_release_version:-0}|g" <<< "$buffer")
		buffer=$(sed "s|<?title_description?>|$title_description|g" <<< "$buffer")
		buffer=$(sed "s|<?essential_ipks?>|${essential_ipks:=essential ipks}|g" <<< "$buffer")
		buffer=$(sed "s|<?essential_pips?>|${essential_pips:=essential pips}|g" <<< "$buffer")
		buffer=$(sed "s|<?exclusion_pips?>|${exclusion_pips:=exclusion pips}|g" <<< "$buffer")
		buffer=$(sed "s|'<?management_debug_log_longest_string_length?>'|${#management_debug_log_longest_string}|g" <<< "$buffer")

		buffer=$(sed "s|<?cdn_nzbget_dev_packages_url?>|$cdn_nzbget_dev_packages_url|g" <<< "$buffer")
		buffer=$(sed "s|<?cdn_other_packages_url?>|$cdn_other_packages_url|g" <<< "$buffer")
		buffer=$(sed "s|<?cdn_qnap_dev_packages_url?>|$cdn_qnap_dev_packages_url|g" <<< "$buffer")
		buffer=$(sed "s|<?cdn_sherpa_packages_url?>|$cdn_sherpa_packages_url|g" <<< "$buffer")
		buffer=$(sed "s|<?cdn_sherpa_packages_base_url?>|$cdn_sherpa_packages_base_url|g" <<< "$buffer")

		[[ -e $2 ]] && chmod +w "$2"
		echo "$buffer" > "$2"
	fi

	ShowDone

	}

Squeeze()
	{

	# Throwaway as many unnecessary bytes as-possible.

	# Inputs: (local)
	#	$1 = Input pathfile to process for excess material.
	#	$2 = Output pathfile.

	# Outputs: (local)
	#	$? = 0

	if [[ -f "$1" ]]; then			# ignore symlinks.
		echo -n 'squeezing ... '
		local buffer=$(<"$1")

		buffer=$(sed '/devdebug/d' <<< "$buffer")												# Remove lines with 'devdebug' tag.

		buffer=$(sed '/[#>][[:space:]]>/! s/[[:space:]]>/>/g' <<< "$buffer")					# Remove whitespace before fd1 redirects.
		buffer=$(sed '/squeezer-ignore/! s/>[[:space:]]/>/g' <<< "$buffer")						# Remove whitespace after fd1 redirects, except for lines with 'squeezer-ignore' tag.
		buffer=$(sed '/[#<][[:space:]]</! s/[[:space:]]</</g' <<< "$buffer")					# Remove whitespace before fd0 redirects.
		buffer=$(sed 's/<[[:space:]]/</g' <<< "$buffer")										# Remove whitespace after fd0 redirects.

		buffer=$(sed 's/\;[[:space:]]/;/g' <<< "$buffer")										# Remove whitespace after semicolons.
		buffer=$(sed 's/[[:space:]]\;/;/g' <<< "$buffer")										# Remove whitespace before semicolons.

		buffer=$(sed 's/\&\&[[:space:]]/\&\&/g' <<< "$buffer")									# Remove whitespace after inline true test.
#		buffer=$(sed 's/[[:space:]]\&\&/\&\&/g' <<< "$buffer")									# Remove whitespace before inline true test. WARNING: can't remove whitespace before inline true test within a double-test block.
		buffer=$(sed 's/\]][[:space:]]\&\&/]]\&\&/g' <<< "$buffer")								# Remove whitespace before inline true test preceded by double-test exit.

		buffer=$(sed 's/||[[:space:]]/||/g' <<< "$buffer")										# Remove whitespace after inline false test.
#		buffer=$(sed 's/[[:space:]]||/||/g' <<< "$buffer")										# Remove whitespace before inline false test. WARNING: can't remove whitespace before inline false test within a double-test block.
		buffer=$(sed 's/\]\][[:space:]]||/]]||/g' <<< "$buffer")								# Remove whitespace before inline false test preceded by double-test exit.
		buffer=$(sed 's/[[:space:]]||return/||return/g' <<< "$buffer")							# Remove whitespace before inline false test followed by 'return'.
		buffer=$(sed 's/[[:space:]]\&\&return/\&\&return/g' <<< "$buffer")						# Remove whitespace before inline true test followed by 'return'.
		buffer=$(sed 's/[[:space:]]\&\&Is/\&\&Is/g' <<< "$buffer")								# Remove whitespace before inline true test followed by 'Is'.
		buffer=$(sed 's/[[:space:]]||exit/||exit/g' <<< "$buffer")								# Remove whitespace before inline false test followed by 'exit'.
		buffer=$(sed 's/[[:space:]]||continue/||continue/g' <<< "$buffer")						# Remove whitespace before inline false test followed by 'continue'.
		buffer=$(sed 's/[[:space:]]||break/||break/g' <<< "$buffer")							# Remove whitespace before inline false test followed by 'break'.
		buffer=$(sed 's/[[:space:]]||printf/||printf/g' <<< "$buffer")							# Remove whitespace before inline false test followed by 'printf'.
		buffer=$(sed 's/[[:space:]]||\//||\//g' <<< "$buffer")									# Remove whitespace before inline false test followed by '/'.
		buffer=$(sed 's/[[:space:]]||z/||z/g' <<< "$buffer")									# Remove whitespace before inline false test followed by 'z'.

		buffer=$(sed 's/[[:space:]]((/((/g' <<< "$buffer")										# Remove whitespace before inline arithmetic start.

		buffer=$(sed '/squeezer-ignore/! s/[[:space:]]|[[:space:]]/|/g' <<< "$buffer")			# Remove whitespace before-and-after pipe, except for lines with 'squeezer-ignore' tag.

		buffer=$(sed '/squeezer-ignore/! s/^[[:space:]]*//' <<< "$buffer")						# Remove line leading whitespace, except for lines with 'squeezer-ignore' tag.

		# CAUTION: comment tags won't be seen beyond this point.

		buffer=$(sed '/^#[[:space:]].*/d;/#$/d;s/[[:space:]]#[[:space:]].*//' <<< "$buffer")	# Remove comment lines and line comments.
		buffer=$(sed 's/[[:space:]]*$//' <<< "$buffer")											# Remove line trailing whitespace.
		buffer=$(sed '/^$/d' <<< "$buffer")														# Remove empty lines.

		buffer=$(sed "s|Transfer-Encoding: base64|Transfer-Encoding: base64\n|" <<< "$buffer")	# Add a newline after this string so signature block is accepted by QTS.

		buffer=$(sed ':a;N;$!ba; s/()\n{\n/(){\n/g' <<< "$buffer")		# Function start braces: move to function name line. https://stackoverflow.com/a/1252191

		buffer=$(sed ':a;N;$!ba; s/\n;;\n/;;\n/g' <<< "$buffer")		# 'case' pattern block ends: move to last statement.

		buffer=$(sed ':a;N;$!ba; s/\*)\n/*)/g' <<< "$buffer")			# 'case' pattern definitions of any '*)': move first statement to definition line.

		# NOTE: these don't save any bytes, but do reduce the number of lines.

		buffer=$(sed ':a;N;$!ba; s/\n}\n/;}\n/g' <<< "$buffer")			# Function end braces: move to last statement.

		[[ -e $2 ]] && chmod +w "$2"
		echo "$buffer" > "$2"
	fi

	ShowDone

	}

QPKGAbbrvs()
	{

	# Inputs: (local)
	#	$1 = QPKG name.

	# Outputs: (local)
	#	stdout = list of abbreviations that may be used to specify this package (first package found).
	#	$? = 0 if successful, 1 if failed.

	local -i i=0

	for i in "${!r_qpkg_name[@]}"; do
		if [[ ${r_qpkg_name[$i]} = "${1:?package name null}" ]]; then
			echo -n "${r_qpkg_abbrvs[$i]}"
			return 0
		fi
	done

	return 1

	}

TextBrightGreen()
	{

	if [[ $colourful = true ]]; then
		printf '\033[1;32m%s\033[0m' "${1:-}"
	else
		printf '%s' "${1:-}"
	fi

	} 2>/dev/null

TextBrightYellow()
	{

	if [[ $colourful = true ]]; then
		printf '\033[1;33m%s\033[0m' "${1:-}"
	else
		printf '%s' "${1:-}"
	fi

	} 2>/dev/null

