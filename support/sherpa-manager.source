GetBusyBoxVersion()
	{

	/bin/busybox | head -n1

	}

GetBusyBoxCopyright()
	{

	/bin/busybox | head -n2 | tail -n1

	}

GetBusyBoxFunctionCount()
	{

	local a=''

	a=$(/bin/busybox --list 2>/dev/null | wc -l)

	if [[ -n $a ]] && IsNumber $a && [[ $a -gt 0 ]]; then
		printf '%s' "$a"
	else										# BusyBox 1.01 doesn't support the `--list` arg, but can get a rough count of included functions by counting the commas shown by the BusyBox help screen.
		a=$(/bin/busybox)
		a=${a//[!\,]/}							# Remove all chars except commas.
		printf '%s' "${#a}"
	fi

	} 2> /dev/null

GetShellTimeIn()
	{

	# Inputs: (global)
	#	$LOADER_SCRIPT_PPID (this is generated in `sherpa-loader.source`)

	local n=''

	[[ -n ${LOADER_SCRIPT_PPID:-} ]] && n=$(/bin/ps -o pid,etime | /bin/grep $LOADER_SCRIPT_PPID | head -n1)

	FormatAsLongMinutesSecs "${n:6}"

	}

GetOsSysLoadAverages()
