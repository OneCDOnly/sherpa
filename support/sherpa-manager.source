	{

	# Inputs: (local)
	#	$1 (optional) = QPKG name.

	# Inputs: (global)
	#	$qpkg_name (default)

	# Outputs: (local)
	#	$stdout = previous action requested.
	#	$? = 0 (found), !0 (not-found)

	local a=${1:-${qpkg_name:?${FUNCNAME[0]}(): $e_nopnm}}
	local b=$r_qpkg_service_result_path/$a.action

	if [[ -s $b ]]; then
		printf '%s' "$(< "$b")"
		return 0
	else
		printf not-found
		return 1
	fi

	}

