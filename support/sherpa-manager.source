	return 0

	}

GetQpkgDbDependencies()
	{

	# Inputs: (global)
	#	$qpkg_default_index
	#	$qpkg_index
	#	$qpkg_name
	#	$r_qpkg_depends_on[]

	# Outputs: (local)
	#	stdout = list of QPKGs $qpkg_name depends-upon.
	#	$? = 0 (found), !0 (not-found)

	local alt=''
	local first=''
	local found=false
	local g=''
	local oldIFS=$IFS
	local out=''
	local x=''

	g=${r_qpkg_depends_on[$qpkg_index]}
	[[ $g = none ]] && return 1
	[[ $g = default ]] && g=${r_qpkg_depends_on[$qpkg_default_index]}

	if [[ $g != *'|'* ]]; then		# No alternatives were listed.
		printf '%s' "$g"

		return 0
	fi

	# If field contains a pipe character, then need to separately examine each name.
	#	- Read each name by word boundaries.
	#	- If name contains pipe, then read name with IFS as pipe.
	#		- Test each alternative name for compatibility with this NAS. Only output the compatible one.
	#		- If none are compatible, then output the first name found.

	IFS=' '

	for x in $g; do
		found=false

		if [[ $x != *'|'* ]]; then
			out+=' '$x
			continue
		fi

		IFS='|'

		for alt in $x; do
			[[ -z $first && -n $alt ]] && first=$alt

			# Test alternative for compatibility.

			if IsQpkgDbArchOK "$alt"; then
				out+=' '$alt
				found=true
				break
			fi
		done

		[[ $IFS != "$oldIFS" ]] && IFS=$oldIFS

		if [[ $found = false ]]; then
			out+=' '$first
			first=''
		fi
	done

	printf '%s' "$out"

	return 0

	}

GetQpkgDbOptDependencies()
	{

	# Inputs: (global)
	#	$qpkg_default_index
	#	$qpkg_index
	#	$qpkg_name
	#	$r_qpkg_opt_depends_on[]

	# Outputs: (local)
	#	stdout = list of QPKGs $qpkg_name optionally depends-upon.
	#	$? = 0 (found), !0 (not-found)

	local alt=''
	local first=''
	local found=false
	local g=''
	local oldIFS=$IFS
	local out=''
	local x=''

	g=${r_qpkg_opt_depends_on[$qpkg_index]}
	[[ $g = none ]] && return 1
	[[ $g = default ]] && g=${r_qpkg_opt_depends_on[$qpkg_default_index]}

	if [[ $g != *'|'* ]]; then		# No alternatives were listed.
		printf '%s' "$g"

		return 0
	fi

	# If field contains a pipe character, then need to separately examine each name.
	#	- Read each name by word boundaries.
	#	- If name contains pipe, then read name with IFS as pipe.
	#		- Test each alternative name for compatibility with this NAS. Only output the compatible one.
	#		- If none are compatible, then output the first name found.

	IFS=' '

	for x in $g; do
		found=false

		if [[ $x != *'|'* ]]; then
			out+=' '$x
			continue
		fi

		IFS='|'

		for alt in $x; do
			[[ -z $first && -n $alt ]] && first=$alt

			# Test alternative for compatibility.

			if IsQpkgDbArchOK "$alt"; then
				out+=' '$alt
				found=true
				break
			fi
		done

		[[ $IFS != "$oldIFS" ]] && IFS=$oldIFS

		if [[ $found = false ]]; then
			out+=' '$first
			first=''
		fi
	done

	printf '%s' "$out"

	return 0

	}

GetQpkgDbDependents()
	{

	# Inputs: (global)
	#	$qpkg_default_index
	#	$qpkg_index
	#	$qpkg_name
	#	$r_qpkg_depends_on[]
	#	$r_qpkg_name[]

	# Outputs: (local)
	#	stdout = list of QPKGs that depend-upon this QPKG.
	#	$? = 0 (found), !0 (not-found)

	[[ -n $qpkg_name && $qpkg_index -gt 0 && $qpkg_default_index -gt 0 ]] || return

	local -a ar=()
	local -i i=-1			# Default to not-found.
	local re=\\b${qpkg_name}\\b

	if QPKGs-GRindependent.Exist "$qpkg_name"; then
		for i in "${!r_qpkg_name[@]}"; do
			if [[ ${r_qpkg_depends_on[$i]} =~ $re ]]; then
				[[ ${ar[*]:-} != "${r_qpkg_name[$i]}" ]] && ar+=(${r_qpkg_name[$i]})
			fi
		done
	fi

	if [[ ${#ar[@]} -gt 0 ]]; then
		printf '%s' "${ar[*]}"

		return 0
	fi

	return 1

	}

GetQpkgDbOptionals()
	{

	# Inputs: (global)
	#	$qpkg_default_index
	#	$qpkg_index
	#	$qpkg_name
	#	$r_qpkg_name[]
	#	$r_qpkg_opt_depends_on[]

	# Outputs: (local)
	#	stdout = list of QPKGs that optionally depend-upon this QPKG.
	#	$? = 0 (found), !0 (not-found)

	[[ -n $qpkg_name && $qpkg_index -gt 0 && $qpkg_default_index -gt 0 ]] || return

	local -a ar=()
	local -i i=-1			# Default to not-found.
	local re=\\b${qpkg_name}\\b

	if QPKGs-GRoptional.Exist "$qpkg_name"; then
		for i in "${!r_qpkg_name[@]}"; do
			if [[ ${r_qpkg_opt_depends_on[$i]} =~ $re ]]; then
				[[ ${ar[*]:-} != "${r_qpkg_name[$i]}" ]] && ar+=(${r_qpkg_name[$i]})
			fi
		done
	fi

	if [[ ${#ar[@]} -gt 0 ]]; then
		printf '%s' "${ar[*]}"

		return 0
	fi

	return 1

	}

GetQpkgDbIPKs()
	{

	# Inputs: (global)
	#	$qpkg_default_index
	#	$qpkg_index
	#	$qpkg_name
	#	$r_qpkg_requires_ipks[]

	# Outputs: (local)
	#	stdout = list of IPKs $qpkg_index depends-upon.
	#	$? = 0 (found), !0 (not-found)

	[[ -n $qpkg_name && $qpkg_index -gt 0 && $qpkg_default_index -gt 0 ]] || return

	local a=''

	a=${r_qpkg_requires_ipks[$qpkg_index]}
	[[ $a = default ]] && a=${r_qpkg_requires_ipks[$qpkg_default_index]}
	[[ $a = none ]] && return 1

	printf '%s' "$a"

	return 0

	}

GetQpkgDbActiveTest()
	{

	# Return any custom commands required to determine if specified QPKG is active or not.

	# Inputs: (global)
	#	$qpkg_default_index
	#	$qpkg_index
	#	$qpkg_name
	#	$r_qpkg_test_for_active[]

	# Outputs: (local)
	#	stdout = bash tests.
	#	$? = 0 (found), !0 (not-found)

	[[ -n $qpkg_name && $qpkg_index -gt 0 && $qpkg_default_index -gt 0 ]] || return

	a=${r_qpkg_test_for_active[$qpkg_index]}
	[[ $a = default ]] && a=${r_qpkg_test_for_active[$qpkg_default_index]}
	[[ $a = none ]] && return 1

	printf '%s' "$a"

	return 0

	}

GetQpkgServiceAction()
	{

	# Inputs: (local)
	#	$1 (optional) = QPKG name.

	# Inputs: (global)
	#	$qpkg_name (default)

	# Outputs: (local)
	#	$stdout = previous action requested.
	#	$? = 0 (found), !0 (not-found)

	local a=${1:-${qpkg_name:?${FUNCNAME[0]}(): $e_nopnm}}
	local b=''
	[[ -e $r_qpkg_service_results_path/$a.action ]] && b=$(< $r_qpkg_service_results_path/${a}.action)

	if [[ -n $b ]]; then
		printf '%s' "$b"
	else
		printf not-found
	fi

	}

GetQpkgServiceResult()
	{

	# Inputs: (local)
	#	$1 (optional) = QPKG name.

	# Inputs: (global)
	#	$qpkg_name (default)

	# Outputs: (local)
	#	$stdout = last known package service status.
	#	$? = 0 (found), !0 (not-found)

	local a=${1:-${qpkg_name:?${FUNCNAME[0]}(): $e_nopnm}}
	local b=''
	[[ -e $r_qpkg_service_results_path/$a.result ]] && b=$(< $r_qpkg_service_results_path/${a}.result)

	if [[ -n $b ]]; then
		printf '%s' "$b"
	else
		printf not-found
	fi

	}

GetQpkgsIsInstalled()
	{

	local qpkg_name=''

	for qpkg_name in $(QPKGs-GRall:Array); do
		IsQpkgInstalled || continue
		echo "$qpkg_name"
	done

	}

