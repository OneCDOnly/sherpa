QpkgServiceResultWasOk()
	{

	# Returns true if previous action for this package is 'ok'.

	# Inputs: (global)
	#	$qpkg_name

	# Outputs: (local)
	#	$? = true/false

	[[ -n ${qpkg_name:-} ]] || return

	[[ $(GetQpkgServiceResult) = ok ]]

	}

QpkgMatchAbbrv()
	{

	# Inputs: (local)
	#	$1 (string) = a potential package abbreviation supplied by user.

	# Inputs: (global)
	#	$r_qpkg_abbrvs[]
	#	$r_qpkg_name[]

	# Outputs: (local)
	#	stdout = matched installable package name (empty if unmatched).
	#	$? = 0 (matched) / !0 (unmatched)

	[[ -n ${1:-} ]] || return

	local -a ar=()
	local -i i=0
	local -i j=0
	local -i z=1			# Default to 'unmatched'.

	for i in "${!r_qpkg_name[@]}"; do
		ar=(${r_qpkg_abbrvs[$i]})

		for j in "${!ar[@]}"; do
			[[ ${ar[$j]} = "$1" ]] || continue
			printf '%s' "${r_qpkg_name[$i]}"
			z=0
			break 2
		done
	done

	return $z

	}

IsUserOk()
	{

	# Inputs: (global)
	#	$r_args_raw
	#	$r_chars_sudo_prompt

	if ! IsUserSU; then
		if IsOsCanSudo; then
			ShowAsError 'this utility must be run with superuser privileges. Try again as:'
			echo "${r_chars_sudo_prompt}sherpa $r_args_raw" >&2
		else
			ShowAsError "this utility must be run as the 'admin' user. Please login via SSH as 'admin' and try again"
		fi

		return 1
	fi

	return 0

	}

IsUserSU()
	{

	# Inputs: (global)
	#	$EUID

	[[ $EUID -eq 0 ]]

	}

IsCriticalFile()
	{

	# Inputs: (local)
	#	$1 = pathfile to check

	# Outputs: (local)
	#	$? = 0 (exists) or 1 (not exists)

	[[ -n ${1:?${FUNCNAME[0]}(): $e_nopfi} ]] || exit

	local a=${1%% *}		# Extract first word-group.

	if ! [[ -f $a || -L $a ]]; then
		ShowAsAbort "a required NAS system file $(FormatFileName "$a") is missing"

		return 1
	fi

	return 0

	}

IsNtCriticalFile()
	{

	# Inputs: (local)
	#	$1 = pathfile to check

	# Outputs: (local)
	#	$? = 0 (not exists) or 1 (exists)

	! IsCriticalFile "${1:?${FUNCNAME[0]}(): $e_nopfi}"

	}

IsFile()
	{

	# Inputs: (local)
	#	$1 = pathfile to check

	# Outputs: (local)
	#	$? = 0 (exists and is non-zero bytes) or 1 (not exists or is zero bytes)

	[[ -n ${1:?${FUNCNAME[0]}(): $e_nopfi} ]] || exit

	local a=${1%% *}		# Extract first word-group.

	[[ -f $a && -s $a ]]

	}

IsNtFile()
	{

	# Inputs: (local)
	#	$1 = pathfile to check

	# Outputs: (local)
	#	$? = 0 (not exists or is zero bytes) or 1 (exists and is non-zero bytes)

	! IsFile "${1:?${FUNCNAME[0]}(): $e_nopfi}"

	}

IsFileRecent()
	{

	# Inputs: (local)
	#	$1 = pathfilename: file to examine change time of.
	#	$2 (optional) = integer - threshold in minutes. Default is `1440` (1 day).

	# Outputs: (local)
	#	$? = true/false

	# Examine 'status change' time, as this is updated even if file content isn't modified.

	[[ -e ${1:-} && $((($(ConvertNowToSeconds)-$(FileLastStatusChangeEpoch "$1"))/60)) -le ${2:-1440} ]]		# https://stackoverflow.com/a/55622661

	}

IsFileNewer()
	{

	# If $1 is newer than $2, then return true, else return false.

	# Inputs: (local)
	#	$1 = pathfilename: file to examine 'last-modified' time of.
	#	$2 = pathfilename: file to examine 'last-modified' time of.

	# Outputs: (local)
	#	$? = true/false

	[[ -n ${1:-} && -e $1 ]] || return
	[[ -n ${2:-} && -e $2 ]] || return 0				# Treat a non-existent $2 as older than $1.

	[[ $(FileLastModifiedEpoch "$1") -gt $(FileLastModifiedEpoch "$2") ]]

	}

IsEntwareUpgradable()
	{

	local a=$(GetQpkgInstalledDate Entware)

	# NOTE: Entware are not updating packages anymore for older arches: https://entware.net/2024/02/23/Changelog.html

	if [[ $a = undefined || ${a//[!0-9]/} -lt $r_entware_packages_last_updated ]]; then
		case $r_nas_arch in
			armv5tel|i686|x86)
				: # Do nothing.
				;;
			*)
				return
		esac
	fi

	false

	}

IsNonStatusActionRequested()
	{

	local action=''

	for action in "${r_qpkg_actions[@]}"; do
		if QPKGs-AC${action}-to.IsAny; then
			[[ $action != status ]] || continue
			return
		fi
	done

	false

	}

IsOsOk()
	{

	if ! IsOsQNAP; then
		ShowAsAbort 'QNAP shell functions not found ... is this a QNAP NAS?'

		return 1
	fi

	return 0

	}

IsOsQNAP()
	{

	# Is this a QNAP NAS?

	[[ -s /etc/init.d/functions ]]

	}

IsQuTS()
	{

	/bin/grep zfs /proc/filesystems

	} &> /dev/null

IsOsSupported()
	{

	# Inputs: (global)
	#	$r_nas_firmware_ver

	# Unable to test firmwares any earlier than 4.2.6 (but still have 4.2.0 available for TS-559Pro+ ).

	SetOsFirmwareVer

	[[ $r_nas_firmware_ver -ge 400 ]]

	}

IsOsCanAsyncQpkgActions()
	{

	# Inputs: (global)
	#	$r_nas_firmware_ver

	SetOsFirmwareVer

	[[ $r_nas_firmware_ver -ge 520 ]]

	}

IsOsCanSecureDownload()
	{

	# NOTE: `/sbin/curl` with SSL certificate verification enabled:
	#	- fails in:
	#		QTS 4.2.6
	#		QTS 4.4.1
	#		QTS 4.5.1
	#		QTS 4.5.4.1715
	#	- works in:
	#		QTS 4.5.4.2627

	# Inputs: (global)
	#	$r_nas_firmware_ver

	SetQpkgArch
	SetOsFirmwareVer

	[[ $r_nas_firmware_ver -ge 455 ]] && [[ $r_nas_qpkg_arch != a41 ]]		# KLUDGE: secure `curl` ops fail on a41 running QTS 5.2.5

	}

IsOsCanQpkgTimeout()
	{

	# Inputs: (global)
	#	$r_nas_firmware_ver

	SetOsFirmwareVer

	[[ $r_nas_firmware_ver -ge 430 && $r_nas_firmware_ver -le 519 && $r_nas_qpkg_arch != i86 ]]

	}

IsOsCanManageSignedPackages()
	{

	# Inputs: (global)
	#	$r_nas_firmware_ver

	# NOTE: signing fails on QTS 4.3.6 (x31). No cert database (which appears to be a bug, as 4.3.6 is meant to support signed QPKGs).

	SetOsFirmwareVer

	[[ $r_nas_firmware_ver -ge 437 ]]

	}

IsOsCanUnofficialPackages()
	{

	# Inputs: (global)
	#	$r_nas_firmware_ver

	# Must check for "official QPKGs" on QTS 4.3.3 to QTS 4.3.6:

	SetOsFirmwareVer

	[[ $r_nas_firmware_ver -gt 426 && $r_nas_firmware_ver -le 436 ]]

	}

IsOsCanSudo()
	{

	[[ -x /usr/bin/sudo ]]

	}

IsOsCanSedExtRegex()
	{

	# Test if QTS `/bin/sed` can handle extended regexes (early BusyBox versions cannot):

	[[ $(echo -en "\033[1;97ma" | /bin/sed -r 's/\x1b\[[0-9;]*m//g' | /usr/bin/wc -c) -eq 1 ]]

	}

IsOsCanDecimalSleepSeconds()
	{

	# Test if QTS `/bin/sleep` can handle decimal seconds (early BusyBox versions cannot):

	/bin/sleep .01

	} &> /dev/null

IsOsCanAutowidthTableColumns()
	{

	# Inputs: (global)
	#	$r_gnu_awk_cmd

	[[ -x $r_gnu_awk_cmd ]]

	}

IsOsCompatibleWithSigned()
	{

	# Inputs: (global)
	#	$r_nas_firmware_date

	# QTS builds released over these 6 days don't allow unsigned QPKGs to run at-all:

	SetOsFirmwareDate

	[[ $r_nas_firmware_date -lt 20201015 || $r_nas_firmware_date -gt 20201020 ]]

	}

IsOsRequireSignedPackages()
	{

	[[ $(/sbin/getcfg 'QPKG Management' Ignore_Cert -u -d FALSE) = FALSE ]]

	}

IsOsAllowUnofficialPackages()
	{

	[[ $(/sbin/getcfg 'QPKG Management' Check_Official -u -d TRUE) = FALSE ]]

	}

IsOsStarting()
	{

	/bin/ps | /bin/grep '/bin/sh /etc/init.d/rcS' | /bin/grep -v grep

	} &> /dev/null

IsOsStopping()
	{

	/bin/ps | /bin/grep '/bin/sh /etc/init.d/rcK' | /bin/grep -v grep

	} &> /dev/null

IsOsStartingPackages()
	{

	if IsOsCanAsyncQpkgActions; then
		/bin/ps | /bin/grep '/usr/local/sbin/qpkg_service start' | /bin/grep -v grep
	else
		IsOsStarting
	fi

	} &> /dev/null

IsOsStoppingPackages()
	{

	if IsOsCanAsyncQpkgActions; then
		/bin/ps | /bin/grep '/usr/local/sbin/qpkg_service stop' | /bin/grep -v grep
	else
		IsOsStopping
	fi

	} &> /dev/null

IsOsOnline()
	{

	[[ $(GetOsState) = online ]]

	}

IsOsStdKernelPageSize()
	{

	# Standard kernel page size for most QNAP NAS is 4kiB. Non-standard size is 32kiB (confirmed on the TS-431XeU, TS-431X3 & TS-1635).
	# https://www.qnap.com/en-us/how-to/faq/article/why-do-the-installed-third-party-containers-not-run-successfully-on-specific-32-bit-arm-devices

	# Inputs: (global)
	#	$r_kernel_page_size

	SetOsKernelPageSize

	[[ $r_kernel_page_size = 4096B || $r_kernel_page_size = 4kiB ]]

	}

IsOsNonStdKernelPageSize()
	{

	! IsOsStdKernelPageSize

	}

IsOsLoadAverageElevated()
	{

	IsOsLoadAverageAboveTrigger 2

	}

IsOsLoadAverageHigh()
	{

	IsOsLoadAverageAboveTrigger 4

	}

IsOsLoadAverageInsane()
	{

	IsOsLoadAverageAboveTrigger 8

	}

IsOsLoadAverageAboveTrigger()
	{

	# Inputs: (local)
	#	$1 = multiplier

	# Inputs: (global)
	#	$r_cpu_threads

	local a=${1:-1}
	local b=$(GetOsSysLoad1MinAverage); b=${b/./}
	local c=$((r_cpu_threads*a*100))

	[[ $((10#$b)) -ge $((10#$c)) ]]

	}

IsOsSedExtRegexSupported()
	{

	# Inputs: (global)
	#	$sed_ext_regex_supported

	[[ ${sed_ext_regex_supported:-unset} = unset ]] && SetOsSedRegexSupport
	[[ $sed_ext_regex_supported -eq 0 ]]

	}

IsOsDecimalSleepSecondsSupported()
	{

	# Inputs: (global)
	#	$sleep_decimal_seconds_supported

	[[ ${sleep_decimal_seconds_supported:-unset} = unset ]] && SetOsDecimalSleepSecondsSupport
	[[ $sleep_decimal_seconds_supported -eq 0 ]]

	}

IsInTerminal()
	{

	[[ -t 0 ]]

	}

IsError()
	{

	# Inputs: (global)
	#	$_script_error_flag_

	# Outputs: (global)
	#	$_script_error_flag_

	[[ ${_script_error_flag_:=false} = true ]]

	}

IsNtError()
	{

	# Inputs: (global)
	#	$_script_error_flag_

	# Outputs: (global)
	#	$_script_error_flag_

	[[ ${_script_error_flag_:=false} != true ]]

	}

IsQpkgRepoSelfManaged()
	{

	# Is this QPKG managable by sherpa?

	# Inputs: (local)
	#	$1 (optional) = QPKG name.

	# Inputs: (global)
	#	$qpkg_name (default)

	# Outputs: (local)
	#	$? = true/false

	local a=$(GetQpkgInstalledStoreID "${1:-${qpkg_name:?${FUNCNAME[0]}(): $e_nopnm}}")

	[[ -z $a || $a = undefined || $a = sherpa ]]

	}

IsNtQpkgRepoSelfManaged()
	{

	# Is this QPKG not managable by sherpa?

	# Inputs: (local)
	#	$1 (optional) = QPKG name.

	# Inputs: (global)
	#	$qpkg_name (default)

	# Outputs: (local)
	#	$? = true/false

	! IsQpkgRepoSelfManaged "${1:-${qpkg_name:?${FUNCNAME[0]}(): $e_nopnm}}"

	}

IsQpkgBackupExist()
	{

	# Does this QPKG have an existing `backup` file?

	# Inputs: (local)
	#	$1 (optional) = QPKG name.

	# Inputs: (global)
	#	$r_qpkg_bu_path
	#	$qpkg_name (default)

	# Outputs: (local)
	#	$? = true/false

	local a=${1:-${qpkg_name:?${FUNCNAME[0]}(): $e_nopnm}}.config.tar.gz
	local old=$r_qpkg_bu_path/O$a
	local new=$r_qpkg_bu_path/$a

	# KLUDGE: rename prohibited QPKG name (with a leading 'O') backup to migrated QPKG name backup.

	if [[ -e $old && ! -e $new ]]; then
		# If backup file is 500MiB or-less, make a copy of it.
		# If it's larger than this, move it (to copy it would take an unacceptably long time).

		if [[ $(/usr/bin/stat -c %s "$old") -le $((500*(2**20))) ]]; then
			cp "$old" "$new"
		else
			mv "$old" "$new"
		fi
	fi

	[[ -e $new ]]

	}

IsQpkgUpgradable()
	{

	# Does an upgraded QPKG exist?

	# Inputs: (global)
	#	$qpkg_name

	# Outputs: (local)
	#	$? = true/false

	# TODO: might get a little more speed out of this by writing a custom function combining all the checks below, instead of calling existing functions.

	IsValidQpkgInstalled && IsQpkgRepoSelfManaged && IsNtQpkgProhibited && IsQpkgDbMinOSVerOk && IsQpkgDbMaxOSVerOk && IsQpkgDbMinRAMOk && [[ $(GetQpkgInstalledVer) != "$(GetQpkgDbVer)" ]]

	}

IsQpkgInstallable()
	{

	# Can this QPKG be installed?

	# Inputs: (global)
	#	$qpkg_name

	# Outputs: (local)
	#	$? = true/false

	IsNtQpkgInstalled && IsNtValidQpkgInstalled && IsNtQpkgProhibited && IsQpkgDbMinOSVerOk && IsQpkgDbMaxOSVerOk && IsQpkgDbMinRAMOk

	}

IsQpkgDbDependent()
	{

	# Does this QPKG depend on any other QPKGs?

	# Inputs: (global)
	#	$qpkg_index
	#	$r_qpkg_depends_on[]

	# Outputs: (local)
	#	$? = true/false

	[[ $qpkg_index -gt 0 ]] || return

	local a=''

	a=${r_qpkg_depends_on[$qpkg_index]}
	[[ $a != none ]]

	}

IsQpkgDbIndependent()
	{

	# Will this package run independent of other QPKGs?

	# Outputs: (local)
	#	$? = true/false

	! IsQpkgDbOptional && ! IsQpkgDbDependent

	}

IsQpkgDbOptional()
	{

	# Is this QPKG an optional dependency?

	# Inputs: (local)
	#	$1 (optional) (string) = QPKG name - if $1 is explicitly stated, lookup $1 in package lists, ignoring current $qpkg_name and $qpkg_index.

	# Inputs: (global)
	#	$qpkg_name (default for $1)
	#	$r_qpkg_name[]
	#	$r_qpkg_opt_depends_on[]

	# Outputs: (local)
	#	$? = true/false

	local a=${1:-${qpkg_name:?${FUNCNAME[0]}(): $e_nopnm}}
	local -i i=0
	local re=\\b${a}\\b

	for i in "${!r_qpkg_name[@]}"; do
		[[ ${r_qpkg_opt_depends_on[$i]} =~ $re ]] || continue
		return 0
	done

	return 1

	}

IsQpkgDbMinRAMOk()
	{

	# Does this NAS meets the minimum RAM requirements for QPKG name?

	# Inputs: (local)
	#	$1 (optional) = QPKG name.

	# Inputs: (global)
	#	$r_nas_ram_kb
	#	$qpkg_name (default)

	# Outputs: (local)
	#	$? = true/false

	local a=$(GetQpkgDbMinRAM "${1:-${qpkg_name:?${FUNCNAME[0]}(): $e_nopnm}}")

	[[ -n $a ]] && [[ $a = none || $r_nas_ram_kb -ge $a ]]

	}

IsQpkgDbMinOSVerOk()
	{

	# Does this NAS meets the minimum OS firmware version requirements for QPKG name?

	# Inputs: (local)
	#	$1 (optional) (string) = QPKG name - if $1 is explicitly stated, lookup $1 in package lists, ignoring current $qpkg_name and $qpkg_index.

	# Inputs: (global)
	#	$r_nas_firmware_ver
	#	$qpkg_name (default for $1)

	# Outputs: (local)
	#	$? = true/false

	local a=$(GetQpkgDbMinOSVer "${1:-${qpkg_name:?${FUNCNAME[0]}(): $e_nopnm}}")

	SetOsFirmwareVer

	[[ -n $a ]] && [[ $a = none || $r_nas_firmware_ver -ge $a ]]

	}

IsQpkgDbMaxOSVerOk()
	{

	# Does this NAS meets the maximum OS firmware version requirements for QPKG name?

	# Inputs: (local)
	#	$1 (optional) (string) = QPKG name - if $1 is explicitly stated, lookup $1 in package lists, ignoring current $qpkg_name and $qpkg_index.

	# Inputs: (global)
	#	$r_nas_firmware_ver
	#	$qpkg_name (default for $1)

	# Outputs: (local)
	#	$? = true/false

	local a=$(GetQpkgDbMaxOSVer "${1:-${qpkg_name:?${FUNCNAME[0]}(): $e_nopnm}}")

	SetOsFirmwareVer

	[[ -n $a ]] && [[ $a = none || $r_nas_firmware_ver -le $a ]]

	}

IsQpkgDbCanBackup()
	{

	# Does this QPKG service-script support `backup` and `restore` actions?

	# Inputs: (local)
	#	$1 (optional) (string) = QPKG name - if $1 is explicitly stated, lookup $1 in package lists, ignoring current $qpkg_name and $qpkg_index.

	# Inputs: (global)
	#	$r_qpkg_can_backup[]
	#	$qpkg_index
	#	$qpkg_name (default for $1)
	#	$r_qpkg_name[]

	# Outputs: (local)
	#	$? = true/false

	local a=''
	local -i i=0

	if [[ -n ${1:-} ]]; then
		for i in "${!r_qpkg_name[@]}"; do
			[[ ${r_qpkg_name[$i]} = "$1" ]] || continue
			a=${r_qpkg_can_backup[$i]}
			break
		done
	else
		a=${r_qpkg_can_backup[$qpkg_index]}
	fi

	[[ -n $a ]] || a=none
	[[ $a = true ]]

	}

IsQpkgDbCanRestartToUpdate()
	{

	# Does this QPKG service-script support updating the internal application when the QPKG is restarted?

	# Inputs: (local)
	#	$1 (optional) (string) = QPKG name - if $1 is explicitly stated, lookup $1 in package lists, ignoring current $qpkg_name and $qpkg_index.

	# Inputs: (global)
	#	$qpkg_name (default for $1)
	#	$r_qpkg_name[]
	#	$r_qpkg_can_restart_to_update[]

	# Outputs: (local)
	#	$? = 0 (true), !0 (false).

	local a=${1:-${qpkg_name:?${FUNCNAME[0]}(): $e_nopnm}}
	local -i i=0

	for i in "${!r_qpkg_name[@]}"; do
		[[ ${r_qpkg_name[$i]} = "$a" ]] || continue
		${r_qpkg_can_restart_to_update[$i]} && return 0 || break
	done

	return 1

	}

IsQpkgDbCanClean()
	{

	# Does this QPKG service-script support cleaning of the internal application?

	# Inputs: (local)
	#	$1 (optional) (string) = QPKG name - if $1 is explicitly stated, lookup $1 in package lists, ignoring current $qpkg_name and $qpkg_index.

	# Inputs: (global)
	#	$qpkg_name (default for $1)

	# Outputs: (local)
	#	$? = 0 (true), 1 (false).

	local a=${1:-${qpkg_name:?${FUNCNAME[0]}(): $e_nopnm}}
	local -i i=0

	for i in "${!r_qpkg_name[@]}"; do
		[[ ${r_qpkg_name[$i]} = "$a" ]] || continue
		${r_qpkg_can_clean[$i]} && return 0 || break
	done

	return 1

	}

IsQpkgDbSherpaCompatible()
	{

	# Is this QPKG service-script compatible with enhanced actions supplied by sherpa?

	# Inputs: (local)
	#	$1 (optional) (string) = QPKG name - if $1 is explicitly stated, lookup $1 in package lists, ignoring current $qpkg_name and $qpkg_index.

	# Inputs: (global)
	#	$qpkg_index
	#	$r_qpkg_is_sherpa_compatible[]
	#	$qpkg_name (default for $1)

	# Outputs: (local)
	#	$? = true/false

	local a=''
	local -i i=0

	if [[ -n ${1:-} ]]; then
		for i in "${!r_qpkg_name[@]}"; do
			[[ ${r_qpkg_name[$i]} = "$1" ]] || continue
			a=${r_qpkg_is_sherpa_compatible[$i]}
			break
		done
	else
		a=${r_qpkg_is_sherpa_compatible[$qpkg_index]}
	fi

	[[ -n $a ]] || a=none
	[[ $a = true ]]

	}

IsQpkgDbUniqueUnpack()
	{

	# Was this QPKG built to extract itself to a unique path? Requires QDK 2.3.14 or-later.
	# If true, then this QPKG can be installed/reinstalled/upgraded concurrently with other QPKGs.

	# Inputs: (local)
	#	$1 (optional) (string) = QPKG name - if $1 is explicitly stated, lookup $1 in package lists, ignoring current $qpkg_name and $qpkg_index.

	# Inputs: (global)
	#	$qpkg_index
	#	$r_qpkg_is_unique_unpack[]
	#	$qpkg_name (default for $1)

	# Outputs: (local)
	#	$? = true/false

	local a=''
	local -i i=0

	if [[ -n ${1:-} ]]; then
		for i in "${!r_qpkg_name[@]}"; do
			[[ ${r_qpkg_name[$i]} = "$1" ]] || continue
			a=${r_qpkg_is_unique_unpack[$i]}
			break
		done
	else
		a=${r_qpkg_is_unique_unpack[$qpkg_index]}
	fi

	[[ -n $a ]] || a=none
	[[ $a = true ]]

	}

IsQpkgDbWillLog()
	{

	# Does this QPKG service-script log all actions? If-so, when an action fails, user can be directed to check the service-script log.

	# Inputs: (local)
	#	$1 (optional) (string) = QPKG name - if $1 is explicitly stated, lookup $1 in package lists, ignoring current $qpkg_name and $qpkg_index.

	# Inputs: (global)
	#	$qpkg_name (default for $1)

	# Outputs: (local)
	#	$? = 0 (true) / !0 (false).

	local -i i=0

	for i in "${!r_qpkg_name[@]}"; do
		[[ ${r_qpkg_name[$i]} = "${1:-${qpkg_name:?${FUNCNAME[0]}(): $e_nopnm}}" ]] || continue
		${r_qpkg_will_log[$i]} && return 0 || break
	done

	return 1

	}

IsQpkgAutoUpdate()
	{

	# Is the installed QPKG set to auto-update on restart?

	# Inputs: (local)
	#	$1 (optional) (string) = QPKG name - if $1 is explicitly stated, lookup $1 in package lists, ignoring current $qpkg_name and $qpkg_index.

	# Inputs: (global)
	#	$qpkg_name (default for $1)

	# Outputs: (local)
	#	$? = true/false

	[[ $(/sbin/getcfg "${1:-${qpkg_name:?${FUNCNAME[0]}(): $e_nopnm}}" Auto_Update -u -f /etc/config/qpkg.conf) = TRUE ]]

	}

IsQpkgAuthorOk()
	{

	# Inputs: (local)
	#	$1 (optional) (string) = QPKG name - if $1 is explicitly stated, lookup $1 in package lists, ignoring current $qpkg_name and $qpkg_index.

	# Inputs: (global)
	#	$qpkg_name (default for $1)

	# Outputs: (local)
	#	$? = true/false

	local a=${1:-${qpkg_name:?${FUNCNAME[0]}(): $e_nopnm}}

	[[ $(GetQpkgDbAuthor "$a") = "$(GetQpkgAuthor "$a")" ]]

	}

IsNtQpkgAuthorOk()
	{

	# Inputs: (local)
	#	$1 (optional) (string) = QPKG name - if $1 is explicitly stated, lookup $1 in package lists, ignoring current $qpkg_name and $qpkg_index.

	# Inputs: (global)
	#	$qpkg_name (default for $1)

	# Outputs: (local)
	#	$? = true/false

	! IsQpkgAuthorOk "${1:-${qpkg_name:?${FUNCNAME[0]}(): $e_nopnm}}"

	}

IsValidQpkgInstalled()
	{

	# Check if specified QPKG is installed, and the QPKG author is valid.

	# Inputs: (local)
	#	$1 (optional) (string) = QPKG name - if $1 is explicitly stated, lookup $1 in package lists, ignoring current $qpkg_name and $qpkg_index.

	# Inputs: (global)
	#	$qpkg_name (default for $1)

	# Outputs: (local)
	#	$? = true/false

	local a=${1:-${qpkg_name:?${FUNCNAME[0]}(): $e_nopnm}}

	IsQpkgInstalled "$a" && IsQpkgAuthorOk "$a"

	}

IsNtValidQpkgInstalled()
	{

	# Inputs: (local)
	#	$1 (optional) (string) = QPKG name - if $1 is explicitly stated, lookup $1 in package lists, ignoring current $qpkg_name and $qpkg_index.

	# Inputs: (global)
	#	$qpkg_name (default for $1)

	# Outputs: (local)
	#	$? = true/false

	! IsValidQpkgInstalled "${1:-${qpkg_name:?${FUNCNAME[0]}(): $e_nopnm}}"

	}

IsQpkgInstalled()
	{

	# Check if specified QPKG is installed.

	# Inputs: (local)
	#	$1 (optional) (string) = QPKG name - if $1 is explicitly stated, lookup $1 in package lists, ignoring current $qpkg_name and $qpkg_index.

	# Inputs: (global)
	#	$qpkg_name (default for $1)

	# Outputs: (local)
	#	$? = true/false

	local a=${1:-${qpkg_name:?${FUNCNAME[0]}(): $e_nopnm}}

#	/bin/grep "\[$a\]" /etc/config/qpkg.conf
	[[ $(/sbin/getcfg "$a" Name -d undefined -f /etc/config/qpkg.conf) = "$a" ]]

	} > /dev/null

IsNtQpkgInstalled()
	{

	# Inputs: (local)
	#	$1 (optional) (string) = QPKG name - if $1 is explicitly stated, lookup $1 in package lists, ignoring current $qpkg_name and $qpkg_index.

	# Inputs: (global)
	#	$qpkg_name (default for $1)

	# Outputs: (local)
	#	$? = true/false

	! IsQpkgInstalled "${1:-${qpkg_name:?${FUNCNAME[0]}(): $e_nopnm}}"

	}

IsQpkgProhibited()
	{

	# Check if specified QPKG is prohibited (not to be installed).

	# Inputs: (local)
	#	$1 (optional) (string) = QPKG name - if $1 is explicitly stated, lookup $1 in package lists, ignoring current $qpkg_name and $qpkg_index.

	# Inputs: (global)
	#	$qpkg_name (default for $1)

	# Outputs: (local)
	#	$? = true/false

	local re=\\b${1:-${qpkg_name:?${FUNCNAME[0]}(): $e_nopnm}}\\b			# bash 3.2 regex with word boundaries: https://stackoverflow.com/a/9793094

	[[ ${r_qpkgs_name_prohibited[*]} =~ $re ]]

	}

IsNtQpkgProhibited()
	{

	# Inputs: (local)
	#	$1 (optional) (string) = QPKG name - if $1 is explicitly stated, lookup $1 in package lists, ignoring current $qpkg_name and $qpkg_index.

	# Inputs: (global)
	#	$qpkg_name (default for $1)

	# Outputs: (local)
	#	$? = true/false

	! IsQpkgProhibited "${1:-${qpkg_name:?${FUNCNAME[0]}(): $e_nopnm}}"

	}

IsQpkgConflicts()
	{

	# Does specified QPKG conflict with any installed QPKGs?

	# Inputs: (local)
	#	$1 (optional) (string) = QPKG name - if $1 is explicitly stated, lookup $1 in package lists, ignoring current $qpkg_name and $qpkg_index.

	# Inputs: (global)
	#	$qpkg_name (default for $1)

	# Outputs: (local)
	#	$? = true/false

	local a=''

	for a in $(GetQpkgConflicts "${1:-${qpkg_name:?${FUNCNAME[0]}(): $e_nopnm}}"); do
		IsQpkgInstalled "$a" && return
	done

	return 1

	}

IsQpkgMissing()
	{

	# Inputs: (local)
	#	$1 (optional) (string) = QPKG name - if $1 is explicitly stated, lookup $1 in package lists, ignoring current $qpkg_name and $qpkg_index.

	# Inputs: (global)
	#	$qpkg_name (default for $1)

	# Outputs: (local)
	#	$? = true/false.

	local a=$(GetQpkgInstalledPath "${1:-${qpkg_name:?${FUNCNAME[0]}(): $e_nopnm}}")

	[[ $a != undefined && ! -d $a ]]

	}

IsQpkgComplete()
	{

	# Inputs: (local)
	#	$1 (optional) (string) = QPKG name - if $1 is explicitly stated, lookup $1 in package lists, ignoring current $qpkg_name and $qpkg_index.

	# Inputs: (global)
	#	$qpkg_name (default for $1)

	# Outputs: (local)
	#	$? = true/false.

	local a=${1:-${qpkg_name:?${FUNCNAME[0]}(): $e_nopnm}}

	[[ $(/sbin/getcfg "$a" Status -d undefined -f /etc/config/qpkg.conf) = complete ]] && [[ $(/sbin/getcfg "$a" Incomplete_Conf -d undefined -f /etc/config/qpkg.conf) != 1 ]]

	}

IsNtQpkgComplete()
	{

	# Inputs: (local)
	#	$1 (optional) (string) = QPKG name - if $1 is explicitly stated, lookup $1 in package lists, ignoring current $qpkg_name and $qpkg_index.

	# Inputs: (global)
	#	$qpkg_name (default for $1)

	# Outputs: (local)
	#	$? = true/false

	! IsQpkgComplete "${1:-${qpkg_name:?${FUNCNAME[0]}(): $e_nopnm}}"

	}

IsQpkgEnabled()
	{

	# Inputs: (local)
	#	$1 (optional) (string) = QPKG name - if $1 is explicitly stated, lookup $1 in package lists, ignoring current $qpkg_name and $qpkg_index.

	# Inputs: (global)
	#	$qpkg_name (default for $1)

	# Outputs: (local)
	#	$? = true/false

	[[ $(/sbin/getcfg "${1:-${qpkg_name:?${FUNCNAME[0]}(): $e_nopnm}}" Enable -u -d undefined -f /etc/config/qpkg.conf) = TRUE ]]

	}

IsNtQpkgEnabled()
	{

	# Inputs: (local)
	#	$1 (optional) (string) = QPKG name - if $1 is explicitly stated, lookup $1 in package lists, ignoring current $qpkg_name and $qpkg_index.

	# Inputs: (global)
	#	$qpkg_name (default for $1)

	# Outputs: (local)
	#	$? = true/false

	! IsQpkgEnabled "${1:-${qpkg_name:?${FUNCNAME[0]}(): $e_nopnm}}"

	}

IsQpkgSigned()
	{

	# SQL to check $qpkg_name has an entry in OS signed certificate database.

	# Inputs: (local)
	#	$1 (optional) (string) = QPKG name - if $1 is explicitly stated, lookup $1 in package lists, ignoring current $qpkg_name and $qpkg_index.

	# Inputs: (global)
	#	$qpkg_name (default for $1)

	# Output: (local)
	#	$? = true/false

	[[ -s $r_cert_db_pathfile ]] || return

	# https://pynative.com/python-sqlite-select-from-table/

	local a="SELECT 1 from Certificate WHERE QpkgName = '${1:-${qpkg_name:?${FUNCNAME[0]}(): $e_nopnm}}'"
	local b=''

	read -r -d '' b <<EOB
import sqlite3, sys

try:
    sqliteConnection = sqlite3.connect('$r_cert_db_pathfile')			# leader-ignore

    cursor = sqliteConnection.cursor()									# leader-ignore
    sqlite_select_query = """$a"""										# leader-ignore
    cursor.execute(sqlite_select_query)									# leader-ignore
    records = cursor.fetchall()											# leader-ignore
    sys.exit(len(records) == 0)											# leader-ignore
    cursor.close()														# leader-ignore

finally:
    if sqliteConnection:												# leader-ignore
        sqliteConnection.close()										# leader-ignore
EOB

	/usr/local/bin/python2 -c "$b"

	}

IsNtQpkgSigned()
	{

	! IsQpkgSigned "${1:-${qpkg_name:?${FUNCNAME[0]}(): $e_nopnm}}"

	}

IsQpkgTimeoutsIncreased()
	{

	[[ -e /usr/local/sbin/qpkg_service.orig ]]

	}

IsNumber()
	{

	# Input: (local)
	#	$1 = string

	# Output: (local)
	#	$? = 0 if $1 has any numerals.

	[[ -n ${1:-} ]] || return

	local a=${1//[!0-9]/}	# Strip non-digits.

	[[ ${#a} -gt 0 ]]

	}

IsDebug()
	{

	[[ $useropt_debug = true ]]

	}

IsNtDebug()
	{

	! IsDebug

	}

IsVerbose()
	{

	[[ $useropt_verbose = true ]]

	}

IsNtVerbose()
	{

	! IsVerbose

	}

IsAnsiStrippingSupported()
	{

	# Can ANSI codes be removed from text with available utilities?

	if IsOsSedExtRegexSupported; then
		true
	elif [[ -x /opt/bin/sed && -L /opt/etc/passwd ]]; then				# Try to ensure Entware is active first.
		true
	else
		false
	fi

	}

IsHaveSingleQuote()
	{

	# Inputs: (local)
	#	$1 = string to be tested.

	# Outputs: (local)
	#	$? = true if $1 contains a single quote.
	#	$? = false if $1 does not contain a single quote.

	/bin/grep "'" <<< "${1:-}"

	} &> /dev/null

IsLessSupportHeaders()
	{

	local a=$(GetLessVersion)

	IsNumber $a && [[ $a -ge 685 ]]

	}

IsReportLargerThanViewport()
	{

	# Inputs: (local)
	#	$1 = pathfile to be shown.

	[[ -n ${1:-} && -e $1 ]] || return

	if [[ -x $r_gnu_stty_cmd ]] && IsInTerminal; then
		local -r r_terminal_dimensions=$($r_gnu_stty_cmd size)
		local -r r_sess_rows=${r_terminal_dimensions% *}
		local -r r_sess_columns=${r_terminal_dimensions#* }
	else
		local -r r_sess_rows=40
		local -r r_sess_columns=156
	fi

	[[ $(/usr/bin/wc -l < "$1") -ge $r_sess_rows || $(StripANSICodes "$(< "$1")" | /usr/bin/wc -L) -gt $r_sess_columns ]]

	}

IsFuncExist()
	{

	[[ -n ${1:-} && $(type -t "$1") = function ]]

	}

CreatePidFile()
	{

	# Inputs: (global)
	#	$r_async_procs_path

	# Outputs: (global)
	#	$pidfile

	pidfile=$(/bin/mktemp "$r_async_procs_path"/proc_XXXXXX)	# Set $pidfile before launching async process so $pidfile is inherited by that process.

	}

WritePidFile()
	{

	# Inputs: (local)
	#	$1 = process ID to write into file.

	# Inputs: (global)
	#	$pidfile

	[[ -n ${1:-} && -n ${pidfile:-} ]] || return

	echo "$1" > "$pidfile"

	}

RemovePidFile()
	{

	# Inputs: (global)
	#	$pidfile

	[[ -n ${pidfile:-} && -e $pidfile ]] || return

	rm -f "$pidfile"

	}

