GetOsSysLoad1MinAverage()
	{

	/usr/bin/uptime | /bin/sed 's/.*load average: //' | /bin/awk -F', ' '{print $1}'

	}

GetHardwareCPUThreads()
	{

	local n=$(/bin/grep -c '^processor' /proc/cpuinfo)

	[[ $n -eq 0 ]] && n=$(/bin/grep -c '^Processor' /proc/cpuinfo)

	printf '%s' "$n"

