GetHardwareInstalledRAMkb()
	{

	# Outputs: (local)
	#	stdout = text string.

	/bin/grep MemTotal /proc/meminfo | /bin/sed 's/.*: //;s/kB//;s/ //g'

	}

GetHardwareInstalledRAMgb()
	{

	# Outputs: (local)
	#	stdout = text string.

	local a=$(/bin/grep MemTotal /proc/meminfo | /bin/sed 's/.*: //;s/kB//;s/ //g')
	local b=$((((a/1024)*1000)/1024))
	local c=${b%???}.${b:${#b}<3?0:-3}

	printf '%.2f' "$c"

	}

