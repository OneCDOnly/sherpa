_QPKG:sign_()
	{

	# * This function runs asynchronously *

	# Modify the QTS App Center certificate dB, and add an unsigned QPKG as-if it were signed. It adds a QNAP-generated certificate and digital signature to the certificate database for the unsigned QPKG.

	# Running the code below makes the target QPKG effectively "signed", and allows user to install and run this QPKG with the 'Allow installation of applications without a valid digital signature' App Center option unticked.

	# Only required for QTS 4.3.5 and-later firmwares.

	# Inputs: (global)
	#	$qpkg_name
	#	$r_abort_actions_pathfile
	#	$r_cert_db_pathfile
	#	$r_qpkg_certificate
	#	$r_qpkg_signature

	# Outputs: (local)
	#	$? = none, this function executes asynchronously. But an exitcode is recorded in the debug log.

	[[ ! -e $r_abort_actions_pathfile ]] || exit

	FuncForkInit

	local a=''
	local b=''
	local -i retries=0
	local -i z=0

	if ! IsOsCanManageSignedPackages; then
		SaveActionResultToLog QPKG "$qpkg_name" '"sign"' '' sk 'not required: firmware < 4.3.5'
		MarkActionForkAsSkipped
		z=2
	elif ! IsQpkgDbArchOK "$qpkg_name"; then
		SaveActionResultToLog QPKG "$qpkg_name" '"sign"' '' sk 'NAS arch incompatible'
		MarkActionForkAsSkipped
		z=2
	elif ! IsQpkgDbMinOSVerOk "$qpkg_name" || ! IsQpkgDbMaxOSVerOk "$qpkg_name"; then
		SaveActionResultToLog QPKG "$qpkg_name" '"sign"' '' sk "$(GetOsName) version incompatible"
		MarkActionForkAsSkipped
		z=2
	elif ! IsQpkgDbMinRAMOk "$qpkg_name"; then
		SaveActionResultToLog QPKG "$qpkg_name" '"sign"' '' sk 'installed RAM insufficient'
		MarkActionForkAsSkipped
		z=2
	elif IsNtQpkgRepoSelfManaged; then
		SaveActionResultToLog QPKG "$qpkg_name" '"sign"' '' sk "assigned to another repository, please 'reassign' it first"
		MarkActionForkAsSkipped
		z=2
	elif [[ ! -e $r_cert_db_pathfile ]]; then
		SaveActionResultToLog QPKG "$qpkg_name" '"sign"' '' sa "$(GetOsName) QPKG certificate database unavailable, no further signing will occur"
		MarkActionForkAsSkippedAbort
		z=3
	elif IsQpkgSigned; then
		SaveActionResultToLog QPKG "$qpkg_name" '"sign"' '' sk 'already signed'
		MarkActionForkAsSkipped
		z=2
	fi

	[[ $z -eq 0 ]] || FuncForkExit $z

	DebugAsProc "\"signing\" $(FormatPackageName)"

	# https://pynative.com/python-sqlite-insert-into-table/

	a="INSERT INTO Certificate (Type,QpkgName,Cert,DigitalSignature) VALUES ('qpkg','$qpkg_name','$r_qpkg_certificate','$r_qpkg_signature')"

	read -r -d '' b <<EOB
import sqlite3, sys														# squeezer-ignore

try:																	# squeezer-ignore
    sqliteConnection = sqlite3.connect('$r_cert_db_pathfile')			# squeezer-ignore

    cursor = sqliteConnection.cursor()									# squeezer-ignore
    sqlite_add_query = """$a"""											# squeezer-ignore
    cursor.execute(sqlite_add_query)									# squeezer-ignore
    sqliteConnection.commit()											# squeezer-ignore
    cursor.close()														# squeezer-ignore
    sys.exit()															# squeezer-ignore

finally:																# squeezer-ignore
    if sqliteConnection:												# squeezer-ignore
        sqliteConnection.close()										# squeezer-ignore
EOB

	for ((retries=0; retries<10; retries++)); do
		/usr/local/bin/python2 -c "$b"
		z=$?

		case $z in
			5) 		# SQLITE_BUSY
				sleep 0.5
				;;
			*)
				break
		esac
	done

	if [[ $z -eq 0 ]]; then
		SaveActionResultToLog QPKG "$qpkg_name" '"sign"' '' ok
		SendPackageStateChange ISsigned
		MarkActionForkAsOk
	else
		SaveActionResultToLog QPKG "$qpkg_name" '"sign"' '' er "$(Parenthesise "$z") but don't know why. Please report this as a bug"
		SendParentCommand 'show_suggest_raise_issue=true'
		MarkActionForkAsError
		z=1		# Remap to 1.
	fi

	FuncForkExit $z

	}

_QPKG:unsign_()
	{

	# * This function runs asynchronously *

	# Modify the QTS App Center certificate dB, and remove signing details for a QPKG.

	# Only required for QTS 4.3.5 and-later firmwares.

	# Inputs: (global)
	#	$qpkg_name
	#	$r_abort_actions_pathfile
	#	$r_cert_db_pathfile

	# Outputs: (local)
	#	$? = none, this function executes asynchronously. But an exitcode is recorded in the debug log.

	[[ ! -e $r_abort_actions_pathfile ]] || exit

	FuncForkInit

	local a=''
	local b=''
	local -i retries=0
	local -i z=0

	if ! IsOsCanManageSignedPackages; then
		SaveActionResultToLog QPKG "$qpkg_name" '"unsign"' '' sk 'not required: firmware < 4.3.5'
		MarkActionForkAsSkipped
		z=2
	elif ! IsQpkgDbArchOK "$qpkg_name"; then
		SaveActionResultToLog QPKG "$qpkg_name" '"unsign"' '' sk 'NAS arch incompatible'
		MarkActionForkAsSkipped
		z=2
	elif ! IsQpkgDbMinOSVerOk "$qpkg_name" || ! IsQpkgDbMaxOSVerOk "$qpkg_name"; then
		SaveActionResultToLog QPKG "$qpkg_name" '"unsign"' '' sk "$(GetOsName) version incompatible"
		MarkActionForkAsSkipped
		z=2
	elif ! IsQpkgDbMinRAMOk "$qpkg_name"; then
		SaveActionResultToLog QPKG "$qpkg_name" '"unsign"' '' sk 'installed RAM insufficient'
		MarkActionForkAsSkipped
		z=2
	elif IsNtQpkgRepoSelfManaged; then
		SaveActionResultToLog QPKG "$qpkg_name" '"unsign"' '' sk "assigned to another repository, please 'reassign' it first"
		MarkActionForkAsSkipped
		z=2
	elif [[ ! -e $r_cert_db_pathfile ]]; then
		SaveActionResultToLog QPKG "$qpkg_name" '"unsign"' '' sa "$(GetOsName) QPKG certificate database unavailable, no further unsigning will occur"
		MarkActionForkAsSkippedAbort
		z=3
	elif IsNtQpkgSigned; then
		SaveActionResultToLog QPKG "$qpkg_name" '"unsign"' '' sk 'not signed'
		MarkActionForkAsSkipped
		z=2
	fi

	[[ $z -eq 0 ]] || FuncForkExit $z

	DebugAsProc "\"unsigning\" $(FormatPackageName)"

	# https://pynative.com/python-sqlite-delete-from-table/

	a="DELETE from Certificate WHERE QpkgName = '$qpkg_name'"

	read -r -d '' b <<EOB
import sqlite3, sys														# squeezer-ignore

try:																	# squeezer-ignore
    sqliteConnection = sqlite3.connect('$r_cert_db_pathfile')			# squeezer-ignore

    cursor = sqliteConnection.cursor()									# squeezer-ignore
    sqlite_delete_query = """$a"""										# squeezer-ignore
    cursor.execute(sqlite_delete_query)									# squeezer-ignore
    sqliteConnection.commit()											# squeezer-ignore
    cursor.close()														# squeezer-ignore
    sys.exit()															# squeezer-ignore

finally:																# squeezer-ignore
    if sqliteConnection:												# squeezer-ignore
        sqliteConnection.close()										# squeezer-ignore
EOB

	for ((retries=0; retries<10; retries++)); do
		/usr/local/bin/python2 -c "$b"
		z=$?

		case $z in
			5)		# SQLITE_BUSY
				sleep 0.5
				;;
			*)
				z=0		# Disregard errors generated while deleting record.
				break
		esac
	done

	if [[ $z -eq 0 ]]; then
		SaveActionResultToLog QPKG "$qpkg_name" '"unsign"' '' ok
		SendPackageStateChange ISsigned
		MarkActionForkAsOk
	else
		SaveActionResultToLog QPKG "$qpkg_name" '"unsign"' '' er "$(Parenthesise "$z") but don't know why. Please report this as a bug"
		SendParentCommand 'show_suggest_raise_issue=true'
		MarkActionForkAsError
		z=1		# Remap to 1.
	fi

	FuncForkExit $z

	}

_QPKG:status_()
	{

	# * This function runs asynchronously *

	# Query a QPKG for its 'status'. Each compatible QPKG will return 0 if application process is active or ready-to-run, 0 if not.

	# Inputs: (global)
	#	$qpkg_name
	#	$r_gnu_timeout_cmd
	#	$r_logs_path
	#	$r_qpkg_status_check_timeout_seconds
	#	$r_status_log_file
	#	$useropt_debug
	#	$useropt_verbose

	# Outputs:
	#	$? = none, this function executes asynchronously. But an exitcode is recorded in the debug log.

	[[ $useropt_verbose != true ]] && exec &> /dev/null

	FuncForkInit

	local a=''
	local b=''
	local -i z=0

	if IsNtValidQpkgInstalled "$qpkg_name"; then
		SaveActionResultToLog QPKG "$qpkg_name" status '' sk 'not installed'
		MarkActionForkAsSkipped
		z=2
	fi

	[[ $z -eq 0 ]] || FuncForkExit

	DebugAsProc "status $(FormatPackageName)"

	a=$(GetQpkgDbActiveTest)
	[[ $useropt_debug = true ]] && b+='DEBUG_QPKG=true '

	if [[ $a = builtin ]]; then
		# Run status query with GNU `timeout` if-possible.

		if [[ -e $r_gnu_timeout_cmd ]]; then
			$r_gnu_timeout_cmd "$r_qpkg_status_check_timeout_seconds" /bin/sh -c "${b}$(GetQpkgServicePathFile) status"
			z=$?
		else
			Executer "${b}$(GetQpkgServicePathFile) status" "$r_logs_path/$qpkg_name.$r_status_log_file" log:failure-only
			z=$?
		fi
	elif [[ $a != none ]]; then
		eval "$a" &> /dev/null
		z=$?
	fi

	DebugVar z

	# returncodes 124 and-up are generated by GNU `timeout`.

	case $z in
		0)
			SendPackageStateChange ISactive
			;;
		1)
			SendPackageStateChange ISNTactive
			;;
		124)
			SendPackageStateChange ISslow
			;;
		*)
			SendPackageStateChange ISunknown
	esac

	SaveActionResultToLog QPKG "$qpkg_name" status '' ok
	MarkActionForkAsOk

	FuncForkExit

	}

ClearQpkgInstalledAppCenterNotifier()
	{

	# Clear QPKG name from notifier list.

	# Inputs: (global)
	#	$qpkg_name

	# KLUDGE: `clean` QTS 4.5.1+ App Center notifier status.

	[[ -e /sbin/qpkg_cli ]] && /sbin/qpkg_cli --cancel "$qpkg_name"

	IsNtValidQpkgInstalled && return

	# Must also do this when installing QPKGs at the CLI.

	/sbin/setcfg "$qpkg_name" Status complete -f /etc/config/qpkg.conf

	return 0

	} &> /dev/null

LogQpkgServiceResult()
	{

	# Inputs: (global)
	#	$qpkg_name

	local a=$r_qpkg_service_results_path/$qpkg_name.log

	if ! local b=$(GetQpkgServiceResult); then
		DebugAsWarn "unable to get status of $(FormatPackageName) service. It may be a non-sherpa package, or a sherpa package earlier than 200816c that doesn't support service results."

		return 1
	fi

	case $b in
		failed)
			if [[ -e $a ]]; then
				DebugAsError "$(FormatPackageName) service action failed. Check $(FormatFileName "$a") for more information"
				AddExtLogToSessLog "$a"
			else
				DebugAsError "$(FormatPackageName) service action failed"
			fi
			;;
		in-progress)
			DebugInfo "$(FormatPackageName) service action is in-progress"
			;;
		ok)
			DebugInfo "$(FormatPackageName) service action completed OK"
			;;
		*)
			DebugAsWarn "$(FormatPackageName) service status is unrecognised or unsupported"
	esac

	return 0

	}

GetQpkgInstalledPath()
	{

	# Inputs: (local)
	#	$1 (optional) = QPKG name.

	# Inputs: (global)
	#	$qpkg_name (default)

	# Outputs:
	#	stdout = package installation date.
	#	$? = 0 (found), 250 (not-found).

	/sbin/getcfg "${1:-${qpkg_name:?${FUNCNAME[0]}(): $e_nopnm}}" Install_Path -d undefined -f /etc/config/qpkg.conf

	}

GetQpkgServicePathFile()
	{

	# Inputs: (local)
	#	$1 (optional) = QPKG name.

	# Inputs: (global)
	#	$qpkg_name (default)

	# Outputs: (local)
	#	stdout = service-script pathfile
	#	$? = 0 if found, 250 if not.

	/sbin/getcfg "${1:-${qpkg_name:?${FUNCNAME[0]}(): $e_nopnm}}" Shell -d undefined -f /etc/config/qpkg.conf

	}

GetQpkgDbApplVer()
	{

	# Returns the version number of the application contained within a QPKG.

	# Inputs: (global)
	#	$r_qpkg_appl_version
	#	$qpkg_default_index
	#	$qpkg_index
	#	$qpkg_name
	#	$r_qpkg_name
	#	$r_qpkg_version

	# Outputs: (local)
	#	stdout = application version
	#	$? = 0 if found, !0 if not

	local a=''
	local -i i=0

	if [[ $qpkg_index -gt 0 ]]; then
		a=${r_qpkg_appl_version[$qpkg_index]}
		[[ $a = default ]] && a=${r_qpkg_appl_version[$qpkg_default_index]}
		[[ $a = version ]] && a=${r_qpkg_version[$qpkg_default_index]}
		[[ $a != none ]] || return
	else
		for i in "${!r_qpkg_name[@]}"; do
			if [[ ${r_qpkg_name[$i]} = "$qpkg_name" ]]; then
				a=${r_qpkg_appl_version[$i]}
				[[ $a = version ]] && a=${r_qpkg_version[$qpkg_default_index]}
				[[ $a != none ]] || return
				break
			fi
		done
	fi

	[[ -n $a ]] || return
	[[ $a = dynamic ]] && IsValidQpkgInstalled && ! IsQpkgAutoUpdate && a=static

	printf '%s' "$a"

	return 0

	}

GetQpkgDbVer()
	{

	# Returns the version number of an available (not-installed) QPKG.

	# Inputs: (global)
	#	$qpkg_default_index
	#	$qpkg_index
	#	$qpkg_name

	# Outputs: (local)
	#	stdout = package version
	#	$? = 0 if found, !0 if not

	local a=''
	local -i i=0

#	if [[ $qpkg_index -gt 0 ]]; then
#		a=${r_qpkg_version[$qpkg_index]}
#		[[ $a = default ]] && a=${r_qpkg_version[$qpkg_default_index]}
#		[[ $a != none ]] || return

#		printf '%s' "$a"

#		return 0
#	fi

	a=${qpkg_name:?${FUNCNAME[0]}(): $e_nopnm}

	if [[ -n $a ]]; then
		for i in "${!r_qpkg_name[@]}"; do
			if [[ ${r_qpkg_name[$i]} = "$a" ]]; then
				printf '%s' "${r_qpkg_version[$i]}"

				return 0
			fi
		done
	fi

	return 1

	}

GetQpkgInstalledVer()
	{

	# Returns the version number of an installed QPKG.

	# Inputs: (global)
	#	$qpkg_name

	# Outputs:
	#	stdout = package version
	#	$? = 0 if found, 250 if not.

	/sbin/getcfg "${qpkg_name:?${FUNCNAME[0]}(): $e_nopnm}" Version -d undefined -f /etc/config/qpkg.conf

	}

GetQpkgInstalledStoreID()
	{

	# Returns the presently assigned repository store ID of an installed QPKG.

	# Inputs: (local)
	#	$1 (optional) = QPKG name.

	# Inputs: (global)
	#	$qpkg_name (default)

	# Outputs: (local)
	#	stdout = package store ID
	#	$? = 0 if found, 250 if not.

	/sbin/getcfg "${1:-${qpkg_name:?${FUNCNAME[0]}(): $e_nopnm}}" store -d undefined -f /etc/config/qpkg.conf

	}

GetQpkgInstalledDate()
	{

	# Returns the date specified QPKG was installed.

	# Inputs: (local)
	#	$1 (optional) = QPKG name.

	# Inputs: (global)
	#	$qpkg_name (default)

	# Outputs: (local)
	#	stdout = package installation date
	#	$? = 0 if found, 1 if QPKG name unspecified, 250 if not found

	/sbin/getcfg "${1:-${qpkg_name:?${FUNCNAME[0]}(): $e_nopnm}}" date -d undefined -f /etc/config/qpkg.conf

	}

GetQpkgInstalledOriginalPath()
	{

	# Inputs: (local)
	#	$1 (optional) = QPKG name.

	# Inputs: (global)
	#	$qpkg_name (default)

	# Outputs: (local)
	#	stdout = the original installation path of this QPKG (even if it was migrated to another volume).
	#	$? = 0 if successful, 1 if failed

	local a=${1:-${qpkg_name:?${FUNCNAME[0]}(): $e_nopnm}}
	local -i i=0

	if [[ ${#QPKGs_were_installed_name[@]} -gt 0 ]]; then
		for i in "${!QPKGs_were_installed_name[@]}"; do
			[[ ${QPKGs_were_installed_name[$i]} = "$a" ]] || continue
			printf '%s' "${QPKGs_were_installed_path[$i]}"

			return 0
		done
	fi

	return 1

	}

GetQpkgDbPathFilename()
	{

	# Inputs: (global)
	#	$r_qpkg_download_path

	# Outputs: (local)
	#	stdout = pathfilename.
	#	$? = 0 if found, !0 if not

	local a=''

	a=$(GetQpkgDbURL)
	[[ -n $a ]] || return

	[[ $(Lowercase "${a##*.}") != qpkg ]] && a=${a%.*}.qpkg		# Swap 'zip' for 'qpkg' here (only for compatibilty with 'QDK.zip').

	printf '%s' "$r_qpkg_download_path/$(/usr/bin/basename "$a")"

	return 0

	}

GetQpkgDbHash()
	{

	# Inputs: (global)
	#	$qpkg_default_index
	#	$qpkg_index
	#	$qpkg_name

	# Outputs: (local)
	#	stdout = QPKG MD5
	#	$? = 0 if found, !0 if not

	[[ -n $qpkg_name && $qpkg_index -gt 0 && $qpkg_default_index -gt 0 ]] || return

	local a=''

	a=${r_qpkg_hash[$qpkg_index]}
	[[ $a = default ]] && a=${r_qpkg_hash[$qpkg_default_index]}
	[[ $a != none ]] || return

	printf '%s' "$a"

	return 0

	}

GetQpkgDbURL()
	{

	# Returns the URL of $qpkg_index.

	# Inputs: (local)
	#	$1 (optional) = QPKG name - if QPKG name is explicitly stated, then lookup QPKG name in package lists, ignoring current $qpkg_name and $qpkg_index.

	# Inputs: (global)
	#	$qpkg_default_index
	#	$qpkg_index
	#	$qpkg_name

	# Outputs: (local)
	#	stdout = QPKG remote URL.
	#	$? = 0 if found, !0 if not

	local a=''
	local -i i=0

	SetQpkgArch

	if [[ -n ${1:-} ]]; then
		for i in "${!r_qpkg_name[@]}"; do
			if [[ ${r_qpkg_name[$i]} = "$1" ]] && [[ ${r_qpkg_arch[$i]} = all || ${r_qpkg_arch[$i]} = "$r_nas_qpkg_arch" ]]; then
				printf '%s' "${r_qpkg_url[$i]}"

				return 0
			fi
		done

		return 1
	else
		a=${r_qpkg_url[$qpkg_index]}
		[[ $a = default ]] && a=${r_qpkg_url[$qpkg_default_index]}
		[[ -n $a ]] || a=none

		printf '%s' "$a"
	fi

	return 0

	}

