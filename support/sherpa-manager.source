GetQpkgConflicts()
	{

	# Inputs: (local)
	#	$1 (optional) = QPKG name - if QPKG name is explicitly stated, then lookup QPKG name in package lists, ignoring current $qpkg_name and $qpkg_index.

	# Inputs: (global)
	#	$qpkg_index
	#	$qpkg_name
	#	$r_qpkg_conflicts_with[]
	#	$r_qpkg_name[]

	# Outputs: (local)
	#	stdout = string of space-separated QPKGs that conflict with this QPKG.
	#	$? = 0 (found), !0 (not-found)

	local a=''
	local -i i=0

	if [[ -n ${1:-} ]]; then
		for i in "${!r_qpkg_name[@]}"; do
			[[ ${r_qpkg_name[$i]} = "$1" ]] || continue
			a=${r_qpkg_conflicts_with[$i]}
			break
		done
	else
		a=${r_qpkg_conflicts_with[$qpkg_index]}
	fi

	[[ -n $a ]] || a=none
	[[ $a = none ]] && return 1

	printf '%s' "$a"

	return 0

	}

