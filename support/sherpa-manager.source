		echo "$qpkg_name"
	done

	}

GetQpkgsNtInstalled()
	{

	local qpkg_name=''

	for qpkg_name in $(QPKGs-GRall:Array); do
		IsNtQpkgInstalled || continue
		echo "$qpkg_name"
	done

	}

