SetCapabilities()
	{

	SetColourisation
	UpdateOsSedRegexSupport
	UpdateOsDecimalSleepSupport

	}

SetColourisation()
	{

	# Inputs: (global)
	#	$r_colourful_default

	# Outputs: (global)
	#	$colourful

	if [[ $r_colourful_default = true ]]; then
		colourful=true
		SendParentChangeEnv 'colourful=true'
	else
		colourful=false
		SendParentChangeEnv 'colourful=false'
	fi

	}

SetOsSedRegexSupport()
	{

	# Outputs: (global)
