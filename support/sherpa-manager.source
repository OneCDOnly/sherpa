MakePath()
	{

	# Inputs: (local)
	#	$1 = path to create.
	#	$2 = reason for this path.

	# Inputs: (global)
	#	$e_nopth
	#	$e_norea

	# Outputs: (local)
	#	$? : 0 = created OK.
	#	   : 1 = creation failed.

	# Outputs: (global)
	#	$show_suggest_raise_issue

	ConfirmVarIsDefined 1 "${1:-}" "$e_nopth" || return
	ConfirmVarIsDefined 2 "${2:-}" "$e_norea" || return

	if ! mkdir -p "$1"; then
		ShowAsError "unable to create $2 path $(FormatFileName "$1") $(FormatExitcode "$?")"
		show_suggest_raise_issue=true

		return 1
	fi

	return 0

	}

ClearPath()
	{

	# Clear (empty) an existing directory, but don't delete the directory.

	# Allows deletion of files in a relatively safe manner. Parent of directory MUST be separately specified to avoid an `rm -rf /*` situation because of empty args.

	# Inputs: (local)
	#	$1 = full path to parent of directory name to clear.
	#	$2 = directory name to clear.

	ConfirmVarIsDefined 1 "${1:-}" "$e_nopth" || return
	ConfirmVarIsDefined 2 "${2:-}" "$e_nopth" || return

	local parent=$1
	local target=$(/usr/bin/basename "$2")

	ConfirmVarIsDefined target "${target:-}" "$e_nopth" || return

	[[ -d $parent/$target ]] && rm -rf "${parent:?}/${target:?}"/*

	}

ConfirmVarIsDefined()
	{

	# Inputs: (local)
	#	$1 = test variable name.
	#	$2 = test variable value.
	#	$3 = error message reason shown if empty or undefined.

	local -i backdepth=1			# 0 = this function, 1 = calling function, etc...
	local first=${1:-undefined}
	local second=${2:-undefined}
	local third=${3:-undefined}

	[[ $second != undefined ]] || { ShowAsBug "${FUNCNAME[$backdepth]}" "\$$first: '$third'"; return ;}

	return 0

	}

FileCountAll()
	{

	# Return number of files in specified path.

	# Inputs: (local)
	#	$1 = path to examine

	[[ -n ${1:-} ]] || return

	compgen -G "$1/*" | /usr/bin/wc -l | /bin/sed 's/^ *//'				# `compgen` usage found here: https://stackoverflow.com/a/6364244

	}

FileCountSpec()
	{

	# Return number of matching files in specified path.

	# Inputs: (local)
	#	$1 = path to examine with a wildcard specifier.

	[[ -n ${1:-} ]] || return

	compgen -G "$1" | /usr/bin/wc -l | /bin/sed 's/^ *//'				# `compgen` usage found here: https://stackoverflow.com/a/6364244

	}

PidLogger()																# devdebug
	{																	# devdebug

	# Inputs: (local)
	#	$1 = stage descriptor.
	#	$2 = PID.
	#	$3 = PPID.
	#	$4 = command string.

	local a=/share/Public/PidLogger.log									# devdebug

	if [[ -z ${1:-} ]]; then											# devdebug
		echo >> "$a"													# devdebug

		return															# devdebug
	fi																	# devdebug

	printf "[%s] stage: '%-20s' ppid: '%-5s' pid: '%-5s' cmd: '%s'\n" "$(date)" "$1" "$3" "$2" "$4" >> "$a" # devdebug
# printf "[%s] stage: '%-20s' pid: '%-5s' cmdline: '%s'\n" "$(date)" "$1" "$2" "$(tr '\0' ' ' < /proc/$2/cmdline)" >> $r_sys_log_path/sherpa/pids/PidLogger-pid-$2.log # devdebug
# printf "[%s] stage: '%-20s' ppid: '%-5s' cmdline: '%s'\n" "$(date)" "$1" "$3" "$(tr '\0' ' ' < /proc/$3/cmdline)" >> $r_sys_log_path/sherpa/pids/PidLogger-pid-$3.log # devdebug

	}																	# devdebug

Executer()
	{

	# Run a commandstring, log the results, and show onscreen if-requested.

	# Inputs: (local)
	#	$1 = commandstring to execute.
	#	$2 = pathfile to record stdout and stderr to.
	#	$3 (optional) = 'log:failure-only' - if specified, stdout & stderr are only recorded in the specified log if the command failed. Default is to always record stdout & stderr.
	#	$4 (optional) = e.g. '10' - an additional acceptable result code. Any other non-zero result from command will be considered a failure.

	# Inputs: (global)
	#	$e_nocmd
	#	$e_nopfi
	#	$r_run_logs_path
	#	$r_sys_run_path
	#	$useropt_debug

	# Outputs: (local)
	#	stdout = commandstring stdout and stderr if script is in 'debug' mode.
	#	/pathfile (specified as $2) = stdout and stderr from commandstring (specified as $1).
	#	$? = result_code of commandstring.

	[[ -n ${1:?${FUNCNAME[0]}(): $e_nocmd} && -n ${2:?${FUNCNAME[0]}(): $e_nopfi} ]] || return

	FuncInit

	local a=$(tr -s ' ' <<< "$1")
	local exec_msg='exec:'
	local -r r_log_pathfile=$(/bin/mktemp $r_run_logs_path/${FUNCNAME[0]}_XXXXXX)
	local -i z=0

	if IsHaveSingleQuote "$a"; then										# Change display quotes depending-on content quote chars.
		exec_msg+=" \"$a\""
	else
		exec_msg+=" '$a'"
	fi

	DebugAsProc "$exec_msg"
	FormatCommand "$a" > "$2"

	if IsDebug; then
		# https://stackoverflow.com/a/1221844

		local -r r_executer_log_pipe=$r_sys_run_path/pipe-$(/bin/date +%s%N)

		/bin/mknod "$r_executer_log_pipe" p
		/usr/bin/tee "$r_log_pathfile" < "$r_executer_log_pipe" &

		eval "$1" > "$r_executer_log_pipe" 2>&1
		z=$?

		rm "$r_executer_log_pipe"
	else
		eval "$a" > "$r_log_pathfile" 2>&1
		z=$?
	fi

	if [[ -s $r_log_pathfile ]]; then
		ShowAsResultAndStdout "$z" "$(< "$r_log_pathfile")" >> "$2"

		if false; then													# devdebug
			rm -f "$r_log_pathfile" 2> /dev/null
		fi																# devdebug
	else
		ShowAsResultAndStdout "$z" '<null>' >> "$2"
	fi

	exec_msg='exec: completed'

	case $z in
		0)
			if [[ ${3:-} != log:failure-only ]] || IsDebug; then
				AddExtLogToSessLog "$2"
			fi

			DebugAsDone "$exec_msg OK ($z)"

			if false; then												# devdebug
				IsNtDebug && rm -f "$2" 2> /dev/null
			fi															# devdebug
			;;
		"${4:-}")
			if [[ ${3:-} != log:failure-only ]] || IsDebug; then
				AddExtLogToSessLog "$2"
			fi

			DebugAsWarn "$exec_msg with permitted errors ($z)"

			if false; then												# devdebug
				IsNtDebug && rm -f "$2" 2> /dev/null
			fi															# devdebug
			;;
		*)
			AddExtLogToSessLog "$2"
			DebugAsError "$exec_msg with errors ($z)"
	esac

	FuncExit $z

	}

KludgeExecuter()
	{

	# A workaround for QTS procs being randomly(?) disowned by their parents.

	# Inputs: (local)
	#	$1 = commandstring to execute.
	#	$2 = pathfile to record stdout and stderr to.

	[[ -n ${1:?${FUNCNAME[0]}(): $e_nocmd} && -n ${2:?${FUNCNAME[0]}(): $e_nopfi} ]] || return

	FuncInit

	local a=$(tr -s ' ' <<< "$1")
	local -i pid=0
	local -i z=0

	if [[ $useropt_verbose = true ]]; then
		eval "$a 2>&1 | /usr/bin/tee $2" &					# Force background process here, and capture PID. NOTE: stdout is buffered here.
	else
		eval "$a" > "$2" 2>&1 &								# Force background process here, and capture PID.
	fi

	pid=$!

	PidLogger												# devdebug
	PidLogger pre-background-wait "$pid" "$PPID" "$a"		# devdebug

	if [[ $pid -gt 1 ]]; then
		wait $pid 2> /dev/null
		z=$?
	fi

	PidLogger post-background-wait "$pid" "$PPID" "$a"		# devdebug
	PidLogger pre-detached-wait "$pid" "$PPID" "$a"			# devdebug

	pid=$(FindPid '/bin/sh' "$r_local_pathfile")

	# If $pid = 0 then process isn't running.

	if [[ $pid -gt 1 ]]; then								# Process has been detached.
		while [[ -e /proc/$pid ]]; do
			sleep .5
		done
	fi

	PidLogger post-detached-wait "$pid" "$PPID" "$a"		# devdebug

	FuncExit $z

	}

FindPid()
	{

	# Inputs: (local)
	#	$1 = Process pathfilename to find.
	#	$2 (optional) = additional string to match if there are multiple processes with identical pathfilenames.

	# Outputs: (local)
	#	$? = 0 (found) or 1 (not found)
	#	stdout = PID

	ConfirmVarIsDefined 1 "${1:-}" "$e_nopfi" || return

	local -i a=0
	local b=''

	[[ -n ${2:-} && $2 != undefined ]] && b=$2

	for a in $(/bin/pidof "$(/usr/bin/basename "$1")"); do
		[[ $a -gt 1 ]] || continue
		[[ -d /proc/$a ]] || continue
		[[ -e /proc/$a/cmdline && -L /proc/$a/exe ]] || continue
		[[ $(< /proc/$a/cmdline) =~ $1 || $(/usr/bin/readlink /proc/$a/exe) = "$1" ]] || continue

		if [[ -n $b ]]; then
			[[ $(< /proc/$a/cmdline) =~ $b ]] || continue	# Check for additional string (if-specified).
		fi

		printf '%s' "$a"

		return
	done

	return 1

	}

DeDupeWords()
	{

	# Inputs: (local)
	#	$1 = string with space-separated words. Duplicate words will be removed.

	[[ -n ${1:-} ]] || return

	tr ' ' '\n' <<< "$1" | /usr/bin/sort | /bin/uniq | tr '\n' ' ' | /bin/sed 's/^[[:blank:]]*//;s/[[:blank:]]*$//'

	}

SortNames()
	{

	# Inputs: (local)
	#	$1 = string with space-separated words. Duplicate words will be removed.

	[[ -n ${1:-} ]] || return

	local a=''
	local b=''
	local c=''
	local d=''

	if (/usr/bin/sort -f < /dev/null &> /dev/null); then		# Only use the ignore-case option '-f' if supported by 'sort'.
		tr ' ' '\n' <<< "$1" | /usr/bin/sort -f | /bin/uniq | tr '\n' ' '
	else														# If only basic 'sort' is available, sort the hard-way.
		a=$(tr ' ' '\n' <<< "$(Lowercase "$1")" | /usr/bin/sort | /bin/uniq | tr '\n' ' ')

		for b in $a; do
			for c in $1; do
				[[ $(Lowercase "$c") = "$b" ]] || continue
				d+=" $c"
				break
			done
		done

		[[ -n $d ]] && tr '\n' ' ' <<< "$d"
	fi

	}

FileMatchesMD5()
	{

	# Inputs: (local)
	#	$1 = pathfile to generate an MD5 checksum for.
	#	$2 = MD5 checksum to compare against.

	# Outputs: (local)
	#	$? = true if checksums match.

	[[ $(GenerateMD5 "${1:?${FUNCNAME[0]}(): $e_nopfi}") = "${2:?${FUNCNAME[0]}(): $e_nochk}" ]]

	}

FileLastModifiedEpoch()
	{

	# Inputs: (local)
	#	$1 = pathfilename: file to examine 'last-modified' time of.

	# Outputs: (local)
	#	stdout = epoch seconds.

	[[ -n ${1:-} && -e $1 ]] || return

	/usr/bin/stat "$1" -c %Y

	}

FileLastStatusChangeEpoch()
	{

	# Examine 'last status change' time, as this is updated even if file content isn't modified.

	# Inputs: (local)
	#	$1 = pathfilename: file to examine 'last status change' time of.

	# Outputs: (local)
	#	stdout = epoch seconds.

	[[ -n ${1:-} && -e $1 ]] || return

	/usr/bin/stat "$1" -c %Z

	}

GenerateMD5()
	{

	# Inputs: (local)
	#	$1 = pathfile to generate an MD5 checksum for.

	# Outputs: (local)
	#	stdout = MD5 checksum.
	#	$? = false if file not found.

	[[ -e ${1:?${FUNCNAME[0]}(): $e_nopfi} ]] && /bin/md5sum "${1:?${FUNCNAME[0]}(): $e_nopfi}" | cut -f1 -d' '

	}

Pluralise()
	{

	[[ ${1:-0} -ne 1 ]] && printf s

	}

Capitalise()
	{

	# Capitalise first character of $1.

	[[ -n ${1:-} ]] || return

	if [[ $1 == sherpa* ]]; then				# 'sherpa' is stylised in all lowercase, so don't capitalise it.
		printf '%s' "$1"
	else
		printf '%s' "$(Uppercase ${1:0:1})${1:1}"
	fi

	}

Parenthesise()
	{

	printf '(%s)' "${1:-}"		# Allow empty $1.

	}

Bracketise()
	{

	[[ -n ${1:-} ]] || return

	printf '[%s]' "$1"

	}

AddPeriod()
	{

	[[ -n ${1:-} ]] || return

	[[ ${1: -1} != ':' && ${1: -1} != '?' && ${1: -1} != '.' ]] && printf '%s.' "$1" || printf '%s' "$1"

	}

Uppercase()
	{

	[[ -n ${1:-} ]] || return

	tr 'a-z' 'A-Z' <<< "$1"

	}

Lowercase()
	{

	[[ -n ${1:-} ]] || return

	tr 'A-Z' 'a-z' <<< "$1"

	}

LTrim()
	{

	# Trim leading whitespace from $1.

	[[ -n ${1:-} ]] || return

	printf '%s' "${1##+(' ')}"

	}

RTrim()
	{

	# Trim trailing whitespace from $1.

	[[ -n ${1:-} ]] || return

	printf '%s' "${1%%+(' ')}"

	}

Trim()
	{

	# Trim leading and trailing whitespace from $1.

	[[ -n ${1:-} ]] || return

	RTrim "$(LTrim "$1")"

	}

FormatAsThous()
	{

	# Format as thousands.

	# A string-based thousands-group formatter totally unreliant on locale.

	# Why? Because builtin `printf` in 32b ARM QTS versions doesn't follow locale. ¯\_(ツ)_/¯

	# Inputs: (local)
	#	$1 = integer value

	[[ -n ${1:-} ]] || return

	local a=${1//[!0-9]/}	# Strip non-digits.
	local b=''
	local c=''

	while [[ ${#a} -gt 0 ]]; do
		b=${a:${#a}<3?0:-3}							# A nifty trick found here: https://stackoverflow.com/a/19858692

		if [[ -z $c ]]; then
			c=$b
		else
			c=$b,$c
		fi

		if [[ ${#b} -eq 3 ]]; then
			a=${a%???}								# Trim rightside 3 characters.
		else
			break
		fi
	done

	printf '%s' "$c"

	return 0

	}

FormatAsIsoBytes()
	{

	/bin/awk 'BEGIN{ u[0]="B"; u[1]="kB"; u[2]="MB"; u[3]="GB"} { n = $1; i = 0; while(n > 1000) { i+=1; n= int((n/1000)+0.5) } print n u[i] } ' <<< "${1:-}"

	}

ShowTitle()
	{

	# Inputs: (global)
	#	$r_args_raw[]
	#	$show_title
	#	$title_shown
	#	$useropt_verbose

	# Outputs: (global)
	#	$title_shown

	[[ $show_title = true && $title_shown = false && $useropt_verbose = false ]] || return

	EraseThisLine

	# Only show ASCII title when no arguments have been specified.

	if [[ -z ${r_args_raw[*]} ]]; then
		Display "$(ShowTitleArt)"
		title_art_shown=true
	else
		Display "$(ShowAsTitleName) $(ShowAsVersion)"
	fi

	title_shown=true

	}

ShowAsTitleName()
	{

	TextBrightWhite sherpa

	}

ShowTitleArt()
	{

	Display "$(TextBrightOrange '     _')"														# squeezer-ignore
	Display "$(TextBrightOrange ' ___| |__   ___ _ __ _ __   __ _')"							# squeezer-ignore
	Display "$(TextBrightOrange "/ __| '_ \ / _ \ '__| '_ \ / _\` |")  $(ShowAsDescription)"	# squeezer-ignore
	Display "$(TextBrightOrange '\__ \ | | |  __/ |  | |_) | (_| |')  $(ShowAsCopyrightBasic)"	# squeezer-ignore
	Display "$(TextBrightOrange '|___/_| |_|\___|_|  | .__/ \__,_|')  $(ShowAsVersion)"			# squeezer-ignore
	Display "$(TextBrightOrange '                    |_|')"										# squeezer-ignore

	}

ShowAsDescription()
	{

	printf '%s' '<?title_description?>'

	}

ShowAsCopyrightBasic()
	{

	printf '%s' '<?copyright_basic?>'

	}

ShowAsVersion()
	{

	printf '%s' "v$r_this_script_ver"

	}

ShowAsAction()
	{

	TextBrightYellow "$(Bracketise action)"

	}

ShowAsSetting()
	{

	TextBrightYellow "$(Bracketise setting)"

	}

ShowAsPackages()
	{

	TextBrightOrange "$(Bracketise packages)"

	}

ShowAsPackageGroup()
	{

	TextBrightOrange "$(Bracketise 'package group')"

	}

ShowAsOptions()
	{

	TextBrightRed "$(Bracketise options)"

	}

FormatPackageName()
	{

	printf '%s' "${1:-${qpkg_name:?${FUNCNAME[0]}(): $e_nopnm}}"

	}

FormatFileName()
	{

	printf '%s' "'${1:?${FUNCNAME[0]}(): $e_nofil}'"

	}

ShowAsURL()
	{

	TextUnderlinedCyan "${1:?${FUNCNAME[0]}(): $e_nourl}"

	}

FormatExitcode()
	{

	printf '%s' "'${1:?${FUNCNAME[0]}(): $e_noext}'"

	}

FormatLogFilename()
	{

	# Inputs: (global)
	#	$r_chars_results

	printf '%s' "${r_chars_results}log file: '${1:?${FUNCNAME[0]}(): $e_nofil}'"

	}

FormatCommand()
	{

	# Inputs: (global)
	#	$r_chars_results

	echo "${r_chars_results}command: '${1:?${FUNCNAME[0]}(): $e_nocmd}'"

	}

FormatNWords()
	{

	[[ ${#1} -gt 0 ]] || return

	local a=''
	local -i n=0
	local words=($1)
	local words_max=${2:-3}
	local word_colour=${3:-TextUncoloured}
	local word_count=${#words[@]}

	for ((n=1; n<=word_count; n++)); do
		if [[ $n -eq 1 && $words_max -eq 1 ]]; then
			if [[ $word_count -eq 1 ]]; then
				a+=$($word_colour "${words[$((n-1))]}")
			else
				a+=$($word_colour "$((word_count-words_max+1))")' others'
			fi

			break
		elif [[ $n -ge $words_max && $((word_count-words_max)) -gt 0 ]]; then
			a+=$($word_colour "$((word_count-words_max+1))")' others'
			break
		fi

		a+=$($word_colour "${words[$((n-1))]}")

		if [[ $((n+1)) -eq $word_count ]] || [[ $((n+1)) -ge $words_max && $((word_count-words_max)) -gt 0 ]]; then
			a+=' & '
		elif [[ $n -lt $word_count ]]; then
			a+=', '
		fi
	done

	printf '%s' "$a"

	}

ShowAsResultAndStdout()
	{

	[[ -n ${1:-} && -n ${2:-} ]] || return

	local a=$r_chars_results

	[[ ${1:-0} -ne 0 ]] && a=$r_chars_alert

	echo "${a}result: $(FormatExitcode "$1")"
	echo "${a}────────── stdout/stderr begins below ──────────"
	echo "$2"
	echo "${a}────────── stdout/stderr is complete ──────────"

	}

DisplayProcReport()
	{

	# Inputs: (local)
	#	$1 (optional) = report type string.

	# Inputs: (global)
	#	$report_title_shown

	# Outputs: (local)
	#	stdout = formatted string

	# Outputs: (global)
	#	$report_title_shown

	[[ ${report_title_shown:=false} = false ]] || return

	local a=''

	[[ -n ${1:-} ]] && a=$1' '

	ShowAsProc "${a}report"

	report_title_shown=true

	}

DebugInfoMajSepr()
	{

	# Debug info major separator.

	# Inputs: (global)
