	/sbin/getcfg "$1" u -d undefined -f /etc/config/3rd_pkg_v2.conf

	}

GetOsUptime()
	{

	local n=$(< /proc/uptime)

	ConvertSecondsToDuration "${n%%.*}"

	}

GetUserLIBC()
	{

	local a=$(/sbin/ldd --version | head -n1)

	printf '%s' "${a:4}"			# Trim 'ldd ' from front of string.

