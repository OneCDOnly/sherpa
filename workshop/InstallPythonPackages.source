# A half-hearted attempt at expanding the range of files examined by the service-script when building a list of PyPI modules to install.

# Maybe prefix those supplied with each QPKG as 'pypi-' instead of 'pip-' ?

InstallPythonPackages()
	{

	# Inputs: (global)
	#	$app_version
	#	$r_appl_version_store_pathfile
	#	$install_pip_deps
	#	$new_env
	#	$r_qpkg_name
	#	$qpkg_repo_path
	#	$silence_pypi_errors
	#	$venv_pip_pathfile

	IsVirtualPythonEnv || return 0

	local a=''
	local b=''
	local c=''

	module_filenames=(essential exclusions recommended rename requirements)

	for a in "${module_filenames[@]}"; do
		local default_pip_"$a"_modules_pathfile=$r_qpkg_path/pip-$a.txt
		local default_"$a"_modules_pathfile=$r_qpkg_path/$a.txt

		local pip_"$a"_modules_pathfile=$qpkg_repo_path/pip-$a.txt
		local "$a"_modules_pathfile=$qpkg_repo_path/$a.txt
	done

	local cmd=''
# 	local default_pip_essential_modules_pathfile=$r_qpkg_path/pip-essential.txt
# 	local default_pip_exclusions_modules_pathfile=$r_qpkg_path/pip-exclusions.txt
# 	local default_pip_recommended_modules_pathfile=$r_qpkg_path/pip-recommended.txt
# 	local default_pip_rename_modules_pathfile=$r_qpkg_path/pip-rename.txt
# 	local default_pip_requirements_modules_pathfile=$r_qpkg_path/pip-requirements.txt
# 	local default_requirements_modules_pathfile=$r_qpkg_path/requirements.txt
	local module_exclusions=''
	local no_pip_deps=' --no-deps'
	local no_pips_installed=true
# 	local pip_essential_modules_pathfile=$qpkg_repo_path/pip-essential.txt
# 	local pip_exclusions_modules_pathfile=$qpkg_repo_path/pip-exclusions.txt
# 	local pip_requirements_modules_pathfile=$qpkg_repo_path/pip-requirements.txt
	local pyproject_pathfile=$qpkg_repo_path/pyproject.toml
	local re=''
# 	local recommended_modules_pathfile=$qpkg_repo_path/recommended.txt
# 	local requirements_modules_pathfile=$qpkg_repo_path/requirements.txt

	[[ $install_pip_deps = true ]] && no_pip_deps=''

	if IsNotVirtualPythonEnvExist; then
		DisplayAndCommitErrorToAllLogs 'unable to install addons: virtual Python environment does not exist'

		SetError; return 1
	fi

	IsNotAutoUpdate && [[ $new_env = false ]] && return 0

	if [[ $r_qpkg_name = OWatcher3 ]]; then
		# Need to install `m2r` PyPI module first.
		DisplayRunAndLog "KLUDGE: install 'm2r' PyPI module first" "$venv_pip_pathfile install${no_pip_deps} --no-input m2r" log:failure-only

		if [[ $? -gt 0 && $silence_pypi_errors = false ]]; then
			CommitWarnToSysLog "'mr2' PyPI module installation failed"
		fi
	fi

	# Edit developer-provided Python module requirements files out-of-repo.
	# NOTE: Always prefer QPKG-supplied PyPI lists over repo-supplied versions.

	for a in "${module_filenames[@]}"; do
 		local b="$default_pip_${a}_modules_pathfile"
 		local c="$pip_${a}_modules_pathfile"

 		b=${!b}
 		c=${!c}

		[[ ! -e $b && -e $c && -d $(/usr/bin/dirname "$b") ]] && cp -f "$c" "$b"
		[[ -e $b ]] && c=$b
	done

# 	[[ ! -e $default_pip_essential_modules_pathfile && -e $pip_essential_modules_pathfile && -d $(/usr/bin/dirname "$default_pip_essential_modules_pathfile") ]] && cp -f "$pip_essential_modules_pathfile" "$default_pip_essential_modules_pathfile"
# 	[[ -e $default_pip_essential_modules_pathfile ]] && pip_essential_modules_pathfile=$default_pip_essential_modules_pathfile
#
# 	[[ ! -e $default_pip_requirements_modules_pathfile && -e $requirements_modules_pathfile && -d $(/usr/bin/dirname "$default_pip_requirements_modules_pathfile") ]] && cp -f "$requirements_modules_pathfile" "$default_pip_requirements_modules_pathfile"
# 	[[ -e $default_pip_requirements_modules_pathfile ]] && requirements_modules_pathfile=$default_pip_requirements_modules_pathfile
#
# 	[[ ! -e $default_pip_recommended_modules_pathfile && -e $recommended_modules_pathfile && -d $(/usr/bin/dirname "$default_pip_recommended_modules_pathfile") ]] && cp -f "$recommended_modules_pathfile" "$default_pip_recommended_modules_pathfile"
# 	[[ -e $default_pip_recommended_modules_pathfile ]] && recommended_modules_pathfile=$default_pip_recommended_modules_pathfile

	# Must remove these modules from repo txt files, and use the ones installed via `opkg` instead (if-available).
	# If not, `pip` will attempt to compile these, which fails on various arches.

	if [[ -e $pip_exclusions_modules_pathfile ]]; then
		module_exclusions=$(/bin/tr '\n' ' ' <<< "$(StripComments "$(< "$pip_exclusions_modules_pathfile")")")
		module_exclusions=${module_exclusions%* }

		if [[ -n $module_exclusions ]]; then
			if [[ -e /opt/bin/sed ]]; then
				re="^(${module_exclusions// /|})$"			# Replace whitespace with pipes to match each word as whole line (extended regex).
			else
				re="^${module_exclusions// /\$\|^}$"		# Replace whitespace with regex to match each word as whole line.
			fi
		fi

		if [[ -n $re ]]; then
			for a in $pip_essential_modules_pathfile $requirements_modules_pathfile $recommended_modules_pathfile $pyproject_pathfile; do
				if [[ -e $a ]]; then
					if [[ -e /opt/bin/sed ]]; then
						cmd="/opt/bin/sed -i -E '/${re}/Id' $a"		# Perform extended and case-insensitive matching.
					else
						cmd="/bin/sed -i '/${re}/d' $a"				# Eh, hope for the best, but this should never run. If Entware isn't installed, Python applications can't be run anyway.
					fi

					DisplayRunAndLog "exclude problematic PyPI modules from $(/usr/bin/basename "$a")" "$cmd" log:failure-only
				fi
			done
		fi
	fi

	# Install PyPI modules.

	for a in $pip_essential_modules_pathfile $requirements_modules_pathfile $recommended_modules_pathfile; do
		if [[ -e $a ]]; then
			DisplayRunAndLog "install PyPI modules from $(/usr/bin/basename "$a")" "$venv_pip_pathfile install${no_pip_deps} --no-input --upgrade pip -r $a" log:failure-only

			if [[ $? -gt 0 && $silence_pypi_errors = false ]]; then
				CommitWarnToAllLogs 'PyPI module installation failed'
			fi

			no_pips_installed=false
		fi
	done

	# KLUDGE: `manytolinux2014` builds are problematic in QTS, so rename these locally.

	if [[ -e $default_pip_rename_modules_pathfile ]]; then
		for a in $(StripComments "$(< "$default_pip_rename_modules_pathfile")"); do
			RenameSharedObjectFile "$a"
		done
	fi

	if IsSupportGetAppVersion; then
		GetAppVersion

		if [[ $new_env = false && -e $r_appl_version_store_pathfile && $(< "$r_appl_version_store_pathfile") != "$app_version" ]]; then
			# Remove existing .pyc files to prevent runtime errors
			DisplayRunAndLog 'clean Python bytecode files' "/opt/bin/find $qpkg_repo_path -type d -name '__pycache__' -print0 | xargs -I {} -0 rm -rf '{}'
" log:failure-only
		fi

		if [[ ! -e $r_appl_version_store_pathfile || $(< "$r_appl_version_store_pathfile") != "$app_version" ]]; then
			# Generate language translations.
			DisplayRunAndLog 'generate language translations' "cd $qpkg_repo_path; $venv_python_pathfile $qpkg_repo_path/tools/make_mo.py" log:failure-only
		fi

		SaveAppVersion
	fi

	return 0

	}
